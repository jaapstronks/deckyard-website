{
  "name": "presentation-system-website",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-docs": "node scripts/sync-docs.js",
    "sync-slide-types": "node scripts/generate-slide-types.js",
    "check-slide-types": "node scripts/generate-slide-types.js --check",
    "dev": "npm run sync-docs && astro dev",
    "build": "npm run sync-docs && astro build",
    "preview": "astro preview",
    "check": "npm run sync-docs && astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm run build"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/starlight": "^0.35.0",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/funnel-sans": "^5.2.8",
    "@fontsource/space-mono": "^5.2.9",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^5.0.0",
    "satori": "^0.29.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  }
}
