---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import {
  ui,
  languages,
  defaultLang,
  getLangFromUrl,
  stripLangFromPath,
  localizePath,
  type Lang,
} from '@/i18n';
import { ogImageForPath } from '@/lib/og/targets';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/funnel-sans';
import '@fontsource/space-mono';
import '@fontsource/space-mono/700.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  /**
   * Where this page can be read in each locale. Omit it and every locale gets
   * the same path, which is right for everything under [...locale]. Pages that
   * break that assumption pass a map: a locale left out has no version of this
   * page, and one that is present may sit at an entirely different URL - a
   * Dutch blog post is its own file with its own Dutch slug.
   */
  localeUrls?: Partial<Record<Lang, string>>;
  /**
   * Where the language switcher sends someone who picks a locale this page has
   * no version in. Root-form path of the nearest page that does exist.
   */
  localeFallback?: string;
}

const {
  title,
  description,
  ogImage,
  type = 'website',
  publishedTime,
  localeUrls,
  localeFallback = '/',
} = Astro.props;

const lang: Lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const currentPath = Astro.url.pathname;

const siteUrl = 'https://deckyard.eu';
const canonicalUrl = new URL(currentPath, siteUrl).href;

// Share image, in order: whatever the page asked for, else the card generated
// for this exact route, else the hand-made homepage card. Pages never have to
// know a card exists - adding one in src/lib/og/targets.ts is enough.
const resolvedOgImage =
  ogImage ?? (await ogImageForPath(currentPath)) ?? '/images/og/deckyard-og.png';
const ogImageUrl = new URL(resolvedOgImage, siteUrl).href;

// hreflang alternates: this page in the locales it was actually built for.
// A set of one is not a set - a page with no counterpart gets no alternates at
// all, rather than advertising a twin that 404s and breaking the reciprocity
// Google expects both ways.
const { path: logicalPath } = stripLangFromPath(currentPath);
const pageUrls: Partial<Record<Lang, string>> =
  localeUrls ??
  Object.fromEntries(
    (Object.keys(languages) as Lang[]).map((l) => [l, localizePath(logicalPath, l)])
  );
const pageLocales = Object.keys(pageUrls) as Lang[];

const alternates =
  pageLocales.length > 1
    ? pageLocales.map((l) => ({ hreflang: l, href: new URL(pageUrls[l]!, siteUrl).href }))
    : [];
// x-default names the version to serve when no language matches, so it only
// means anything while there is something to choose between.
const xDefaultHref = pageUrls[defaultLang]
  ? new URL(pageUrls[defaultLang]!, siteUrl).href
  : undefined;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Deckyard',
  url: siteUrl,
  logo: `${siteUrl}/images/deckyard-full-logo.svg`,
  description:
    'Open source, self-hostable presentation platform for organizations that want to own their brand, data and infrastructure.',
  sameAs: ['https://dreamkit.eu'],
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <!-- Theme, resolved before anything paints. `color-scheme` is a token now
         (tokens.css) rather than a meta, because it has to flip with the page.
         This meta is the browser-chrome colour and the script below keeps it in
         step; it sits above the script so there is something to update on the
         first run.

         The script is Starlight's ThemeProvider contract to the letter: the same
         `starlight-theme` key, the same empty string for "follow the OS" (never
         the word auto), the same inverted media query - light only when the OS
         says light - and the same resolved value on <html data-theme>. Sharing
         the contract is the whole reason docs and marketing cannot disagree
         about which theme the reader asked for; they are two halves of one site
         reading one preference. -->
    <meta name="theme-color" content="#254d38" />
    <script is:inline>
      (() => {
        const readStored = () => {
          try {
            return localStorage.getItem('starlight-theme') || '';
          } catch {
            return '';
          }
        };
        const query = window.matchMedia('(prefers-color-scheme: light)');
        const apply = () => {
          const stored = readStored();
          const theme =
            (stored || (query.matches ? 'light' : 'dark')) === 'light' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#254d38' : '#15120f');
          document.dispatchEvent(new CustomEvent('deckyard:themechange', { detail: theme }));
        };
        window.__deckyardApplyTheme = apply;
        apply();
        if (window.__deckyardThemeBound) return;
        window.__deckyardThemeBound = true;
        // ClientRouter swaps <html>, taking data-theme with it.
        document.addEventListener('astro:after-swap', () => window.__deckyardApplyTheme());
        // Nothing stored means "follow the OS", so follow it while it changes.
        query.addEventListener('change', () => {
          if (!readStored()) window.__deckyardApplyTheme();
        });
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Deckyard" />

    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {
      alternates.length > 0 && xDefaultHref && (
        <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
      )
    }

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Deckyard" />
    <meta property="og:locale" content={t.ogLocale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.blogIndex.feedTitle}
      href={new URL(localizePath('/rss.xml', lang), siteUrl).href}
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Privacy-friendly analytics (self-hosted Plausible, no cookies) -->
    <script defer data-domain="deckyard.eu" src="https://analytics.dreamkit.eu/js/script.js"
    ></script>

    <ClientRouter />

    <slot name="head" />
  </head>
  <body>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <a class="skip-link" href="#main">{t.skipToContent}</a>

    <SiteHeader
      currentPath={currentPath}
      lang={lang}
      localeUrls={pageUrls}
      localeFallback={localeFallback}
    />

    <!-- tabindex="-1" so the skip link actually moves focus here. Following a
         fragment scrolls the viewport but only focuses the target if it can
         take focus; without it the next Tab goes back to the header the link
         was there to skip. -->
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter lang={lang} />

    <script>
      // Scroll reveals: IntersectionObserver, re-run after view transitions.
      function initReveals() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-revealed)');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-revealed'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => {
          const delay = el.getAttribute('data-reveal-delay');
          if (delay) (el as HTMLElement).style.setProperty('--reveal-delay', `${delay}ms`);
          io.observe(el);
        });
      }
      initReveals();
      document.addEventListener('astro:page-load', initReveals);
    </script>
  </body>
</html>
