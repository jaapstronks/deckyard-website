---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Waitlist from '@/components/marketing/Waitlist.astro';
import InstallWidget from '@/components/marketing/InstallWidget.astro';
import StructuredTeaser from '@/components/marketing/StructuredTeaser.astro';
import SlideTypeRail from '@/components/marketing/SlideTypeRail.astro';
import FormatCallout from '@/components/marketing/FormatCallout.astro';
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import Button from '@/components/ui/Button.astro';
import DeckEmbed from '@/components/ui/DeckEmbed.astro';
import { ui, localizePath, sandboxUrl, type Lang } from '@/i18n';
import { withFacts } from '@/lib/facts';
import { heroDecks } from '@/lib/decks';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].home;

// Locale-specific social card (NL homepage gets the Dutch OG image).
const ogImage = lang === 'nl' ? '/images/og/deckyard-og-nl.png' : '/images/og/deckyard-og.png';

const compareHref = localizePath('/compare/', lang);
const structuredHref = localizePath('/structured-slides/', lang);

// The hero deck exists per locale, because a deck is written in one language.
// A locale without one keeps the centred hero this page has always had, rather
// than being handed a deck it cannot read; see `src/lib/decks.ts`.
const heroDeck = heroDecks[lang];

// Pillar icons are fixed per feature; only the title/body come from the
// translation dictionary. Order matches t.pillars.
const icons = [
  '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  '<path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/><circle cx="12" cy="12" r="4"/>',
  '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.9 5.7 3.9 9S14.5 18.4 12 21c-2.5-2.6-3.9-5.7-3.9-9S9.5 5.6 12 3Z"/>',
  '<path d="M3 11h4l3 8 4-16 3 8h4"/>',
  '<circle cx="13.5" cy="6.5" r="1"/><circle cx="17.5" cy="10.5" r="1"/><circle cx="8.5" cy="7.5" r="1"/><circle cx="6.5" cy="12.5" r="1"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.8-.7 1.8-1.7 0-.4-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.9.7-1.7 1.7-1.7H17c2.8 0 5-2.2 5-5C22 6 17.5 2 12 2Z"/>',
  '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>',
  '<rect x="2" y="3" width="20" height="7" rx="2"/><rect x="2" y="14" width="20" height="7" rx="2"/><path d="M6 6.5h.01M6 17.5h.01"/>',
];
// `{count}` in the copy is the slide-type figure, substituted from one place so
// the number cannot differ between here and /structured-slides.
const pillars = t.pillars.map((pillar, i) => ({
  ...pillar,
  title: withFacts(pillar.title),
  icon: icons[i] ?? icons[0],
}));
---

<SiteLayout title={t.metaTitle} description={t.metaDescription} ogImage={ogImage}>
  <!-- ============ HERO ============ -->
  <!-- With a deck the hero is two columns and reads left-aligned; without one it
       is the centred column it has always been. The copy is identical either
       way - only the frame around it changes, so a locale getting its export
       later needs no second version of any of this. -->
  <section class:list={['hero', { 'hero--deck': heroDeck }]}>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class:list={['kicker', { 'kicker--center': !heroDeck }]} data-reveal>{t.heroKicker}</p>
        <h1 data-reveal data-reveal-delay="80">
          {t.heroTitleMain}
          <span class="accent">{t.heroTitleHighlight}</span>
        </h1>
        <p class="hero-what" data-reveal data-reveal-delay="140">{t.heroWhatItIs}</p>
        <p class="lead" data-reveal data-reveal-delay="200">{t.heroLead}</p>
        <!-- One action in the hero. The launch list has moved to the closing CTA:
             now that the code is public, "try it" is the thing to ask for here,
             and an email field competing with it only splits the decision. -->
        <div class="hero-sandbox" data-reveal data-reveal-delay="260">
          <Button href={sandboxUrl(lang)} external>{t.sandboxButton}</Button>
          <p class="hero-sandbox-note">{t.sandboxNote}</p>
        </div>
      </div>

      {
        heroDeck && (
          <div class="hero-deck" data-reveal data-reveal-delay="180">
            <DeckEmbed
              src={heroDeck.src}
              poster={heroDeck.poster}
              title={t.heroDeckTitle}
              playLabel={t.heroDeckPlay}
              openLabel={t.heroDeckPlay}
            />
            <p class="hero-deck-note">{t.heroDeckNote}</p>
          </div>
        )
      }
    </div>
  </section>

  <!-- ============ THE IDEA UNDERNEATH (teaser -> explainer) ============ -->
  <StructuredTeaser lang={lang} />

  <!-- ============ AND HERE ARE THE PIECES ============ -->
  <!-- Directly after the teaser on purpose: that section shows one slide made of
       named fields, this one shows that the same is true of every kind of slide
       a deck needs. Idea, then range. It also gives the two sections different
       destinations - the teaser opens /structured-slides, this opens
       /spec/slide-types/, which was three clicks deep and is the best-looking
       page on the site. -->
  <SlideTypeRail lang={lang} />

  <!-- ============ WHAT HAPPENS WHEN AI WRITES FOR YOU ============ -->
  <!-- The emphasis this site used to put on "hosted in Europe" - a tiebreaker in
       a crowded field. This problem is less crowded and more urgent, and the
       typed slide is a structural answer to it rather than a promise. On the dark
       plate because it is the argument, not a feature; sovereignty stays on the
       site as a property (the kicker, the footer, /hosting). -->
  <Section variant="dark">
    <div class="ai-head">
      <p class="kicker">{t.aiKicker}</p>
      <h2>{t.aiTitle}</h2>
      {t.aiLead.map((para) => <p class="lead">{para}</p>)}
    </div>

    <ul class="ai-points">
      {
        t.aiPoints.map((point, i) => (
          <li data-reveal data-reveal-delay={i === 0 ? undefined : i * 80}>
            <h3>{point.title}</h3>
            <p>{point.body}</p>
          </li>
        ))
      }
    </ul>

    <!-- The limit, on the page rather than left to be discovered. -->
    <p class="ai-limit" data-reveal data-reveal-delay="240">{t.aiLimit}</p>

    <div data-reveal data-reveal-delay="280">
      <Button href={structuredHref} variant="ghost">{t.aiCta}</Button>
    </div>
  </Section>

  <!-- ============ AND THE FORMAT IS WRITTEN DOWN ============ -->
  <!-- After the AI argument rather than before it: that section ends on "the
       shape holds", and the shape being a published file is the proof. It also
       gives this run of sections four different destinations in a row -
       /structured-slides, /spec/slide-types/, /structured-slides, /spec/ - where
       two of them used to be the same page twice. -->
  <FormatCallout lang={lang} />

  <!-- ============ WHAT SHIPS ============ -->
  <Section variant="tint">
    <SectionHead center kicker={t.featuresKicker} title={t.featuresTitle} lead={t.featuresLead} />

    <div class="pillars">
      {
        pillars.map((pillar, i) => (
          <div class="pillar" data-reveal data-reveal-delay={i === 0 ? undefined : i * 60}>
            <div class="pillar-icon" aria-hidden="true">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={pillar.icon}
              />
            </div>
            <h3>{pillar.title}</h3>
            <p>{pillar.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- ============ COMING FROM ANOTHER TOOL ============ -->
  <!-- One band rather than a section: the comparison itself lives on /compare/,
       and this is the doorway for the reader who arrived wondering what to use
       instead of PowerPoint. It sits after "what ships" because the trade only
       means something once you know what the thing is. -->
  <Section flushBottom>
    <div class="compare-band" data-reveal>
      <div class="compare-copy">
        <p class="kicker">{t.compareKicker}</p>
        <h2>{t.compareTitle}</h2>
        <p>{t.compareBody}</p>
      </div>
      <Button href={compareHref} variant="ghost">{t.compareCta}</Button>
    </div>
  </Section>

  <!-- ============ INSTALL ============ -->
  <Section>
    <SectionHead
      center
      kicker={ui[lang].install.kicker}
      title={ui[lang].install.title}
      lead={ui[lang].install.lead}
    />
    <div data-reveal data-reveal-delay="80">
      <InstallWidget lang={lang} />
    </div>
  </Section>

  <!-- ============ OPEN SOURCE RELEASE + CTA ============ -->
  <Section variant="dark">
    <SectionHead kicker={t.ctaKicker} title={t.ctaTitle} lead={t.ctaLead} />
    <div class="cta-actions" data-reveal data-reveal-delay="120">
      <Button href={sandboxUrl(lang)} external>{t.ctaSandboxButton}</Button>
      <Button href="https://github.com/jaapstronks/deckyard" variant="ghost" external>
        {t.ctaGithub}
      </Button>
    </div>
    <div data-reveal data-reveal-delay="180">
      <Waitlist id="footer" lang={lang} buttonLabel={t.ctaWaitlistButton} />
    </div>
  </Section>
</SiteLayout>

<style>
  /* ---------- Hero ----------
     Only the homepage has this; the other pages open with .page-hero. */

  .hero {
    padding-block: var(--space-xl) var(--space-4xl);
    overflow: clip;
    background:
      radial-gradient(900px 420px at 12% -8%, rgba(223, 232, 224, 0.9), transparent 65%),
      radial-gradient(700px 380px at 95% 8%, rgba(240, 200, 77, 0.14), transparent 60%),
      var(--paper);
  }

  .hero-inner {
    max-width: 940px;
    margin-inline: auto;
    text-align: center;
  }

  .hero h1 {
    font-size: var(--step-7);
    font-variation-settings:
      'opsz' 96,
      'wght' 720;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .hero h1 .accent {
    color: var(--green);
    font-style: normal;
  }

  /* The orienting sentence: what this is, and what it replaces. It keeps the
     display face and the green so it still reads as the second line of the
     hero, but it is a sentence rather than a slogan - hence the wider measure
     and the step below the old tagline's, which would have run to five lines. */
  .hero-what {
    max-width: 33em;
    margin: 20px auto 0;
    font-family: var(--display);
    font-variation-settings:
      'opsz' 40,
      'wght' 560;
    font-size: var(--step-1);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--green);
    text-wrap: pretty;
  }

  .hero .lead {
    margin: 22px auto 30px;
  }

  /* The waitlist form lives in Waitlist.astro, so reach past the scope to
     center it inside the hero. */
  .hero :global(.waitlist-form) {
    justify-content: center;
    margin-inline: auto;
  }
  .hero :global(.waitlist-note) {
    margin-inline: auto;
    max-width: 40em;
  }

  /* The sandbox button is the primary action; the waitlist sits below it as
     the lower-intent alternative. */
  .hero-sandbox {
    margin: 1.75rem 0 1.5rem;
  }
  .hero-sandbox-note {
    margin-top: 0.7rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  /* ---------- Hero with a deck beside it ----------
     After the rules above on purpose: `.hero--deck h1` and `.hero h1` have the
     same specificity, so the one that wins is the one that comes last. */

  /* Left-aligned at every width, not only where the two columns fit: the deck
     stacks under the copy on a phone, and a centred headline above a
     left-aligned deck reads as two decisions rather than one. */
  .hero--deck .hero-inner {
    max-width: var(--container);
    text-align: left;
  }
  .hero--deck .hero-what,
  .hero--deck .lead {
    margin-inline: 0;
  }
  .hero-deck {
    margin-top: var(--space-lg);
  }
  .hero-deck-note {
    margin: 0.9rem 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-mute);
    max-width: 42em;
  }

  @media (min-width: 1000px) {
    .hero--deck .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      align-items: center;
      gap: var(--space-xl);
    }
    /* The display size is set for a headline running the full container; in
       half of one it would break after every word. */
    .hero--deck h1 {
      font-size: var(--step-5);
    }
    .hero-deck {
      margin-top: 0;
    }
  }

  /* ---------- Feature pillars ---------- */

  .pillars {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-sm);
  }
  @media (max-width: 1080px) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .pillars {
      grid-template-columns: 1fr;
    }
  }

  .pillar {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
    box-shadow: var(--shadow-sm);
  }
  .pillar h3 {
    margin-top: 14px;
  }
  .pillar p {
    color: var(--ink-soft);
    margin-bottom: 0;
    font-size: 0.92rem;
  }

  .pillar-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--green-wash);
    color: var(--green);
  }

  /* ---------- The AI-control argument ----------
     On the dark plate. `.section-dark` flips the semantic tokens for headings,
     leads, kickers and buttons, so those need nothing here - but it does not
     flip `--card`, `--line` or `--ink-soft`, which are light-surface tokens.
     The panels below therefore paint their own dark surface rather than reaching
     for --card and coming out white. */

  .ai-head {
    max-width: 56ch;
  }
  .ai-head h2 {
    margin: 0.35rem 0 0.8rem;
  }
  /* Two paragraphs now, so only the last one loses its bottom margin - the
     first still needs the gap that tells them apart. */
  .ai-head .lead:last-child {
    margin-bottom: 0;
  }

  .ai-points {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 860px) {
    .ai-points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.1rem;
    }
  }
  .ai-points li {
    padding: 1.3rem 1.4rem 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.06);
  }
  .ai-points h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    font-variation-settings: 'wght' 620;
    letter-spacing: -0.015em;
    color: var(--heading-fg);
  }
  .ai-points p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--lead-fg);
  }

  /* Not a disclaimer in small print: full size, because the honesty is doing as
     much work here as the claim above it. Told apart by a rule rather than by a
     lower opacity - the dimmer note colour is 4.4:1 against the light end of this
     section's gradient, and a caveat nobody can read is worse than none. */
  .ai-limit {
    max-width: 58ch;
    margin: var(--space-md) 0;
    padding-left: var(--space-sm);
    border-left: 2px solid var(--brass-soft);
    line-height: 1.65;
    color: var(--lead-fg);
  }

  /* ---------- "Coming from another tool" band ---------- */

  .compare-band {
    display: grid;
    gap: var(--space-sm);
    align-items: center;
    padding: var(--space-md);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }
  @media (min-width: 820px) {
    .compare-band {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-lg);
    }
  }
  .compare-copy {
    max-width: 52ch;
  }
  .compare-copy h2 {
    margin: 0.35rem 0 0.6rem;
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }
  .compare-copy p:last-child {
    margin: 0;
    color: var(--ink-soft);
  }

  /* ---------- Closing CTA ---------- */

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }
</style>
