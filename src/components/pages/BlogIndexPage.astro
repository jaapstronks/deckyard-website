---
import { getCollection } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import PageHero from '@/components/layout/PageHero.astro';
import Section from '@/components/layout/Section.astro';
import { ui, localizePath, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].blogIndex;

const posts = (
  await getCollection('blog', ({ data }) => {
    const langMatch = (data.lang ?? 'en') === lang;
    return langMatch && (import.meta.env.PROD ? !data.draft : true);
  })
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [lead, ...rest] = posts;
const emptyHtml = t.empty
  .replace('{home}', localizePath('/', lang))
  .replace('{rss}', localizePath('/rss.xml', lang));
---

<SiteLayout title={t.metaTitle} description={t.metaDescription}>
  <PageHero kicker={t.kicker} title={t.title} intro={t.intro} />

  <Section>
    {
      posts.length === 0 && (
        <div class="blog-empty" data-reveal>
          <p class="lead" set:html={emptyHtml} />
        </div>
      )
    }
    <div class="post-grid">
      {
        lead && (
          <BlogCard
            id={lead.id}
            lang={lang}
            title={lead.data.title}
            intro={lead.data.intro}
            pubDate={lead.data.pubDate}
            category={lead.data.category}
            heroImage={lead.data.heroImage}
            heroImageAlt={lead.data.heroImageAlt}
            featured
          />
        )
      }
      {
        rest.map((post, index) => (
          <BlogCard
            id={post.id}
            lang={lang}
            title={post.data.title}
            intro={post.data.intro}
            pubDate={post.data.pubDate}
            category={post.data.category}
            heroImage={post.data.heroImage}
            heroImageAlt={post.data.heroImageAlt}
            revealDelay={(index % 3) * 80}
          />
        ))
      }
    </div>
  </Section>
</SiteLayout>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
  }
  @media (max-width: 860px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }

  .blog-empty {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }
  .blog-empty .lead {
    margin-inline: auto;
  }
</style>
