---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Waitlist from '@/components/marketing/Waitlist.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { ui, localizePath, type Lang } from '@/i18n';
import { authorAvatar } from '@/lib/authors';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
  /** This post's URL per language, from its `translationKey` siblings. */
  localeUrls: Partial<Record<Lang, string>>;
}
const { post, lang, localeUrls } = Astro.props;
const t = ui[lang].blogPost;
const { Content } = await render(post);
const { title, intro, pubDate, category, author, heroImage, heroImageAlt, description } = post.data;

const dateLabel = new Intl.DateTimeFormat(t.dateLocale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(pubDate);
const blogHref = localizePath('/blog/', lang);
const avatar = authorAvatar(author);
---

<SiteLayout
  title={`${title} ${t.metaTitleSuffix}`}
  description={description ?? intro}
  type="article"
  publishedTime={pubDate.toISOString()}
  localeUrls={localeUrls}
  localeFallback="/blog/"
>
  <div class="reading-progress" aria-hidden="true"></div>

  <article>
    <PageHero
      as="header"
      kicker={category}
      title={title}
      intro={intro}
      titleTransition={`post-title-${post.id}`}
    >
      <p class="article-byline" slot="meta">
        {
          /* Decorative: the author's name is right beside it, and a portrait
             that repeats the name is one thing announced twice. */
          avatar && (
            <img
              class="article-avatar"
              src={avatar}
              alt=""
              width="48"
              height="48"
              decoding="async"
            />
          )
        }
        <span class="article-author">{author}</span>
        <time datetime={pubDate.toISOString()}>{dateLabel}</time>
      </p>

      {
        heroImage && (
          <figure class="article-figure" slot="below">
            <img
              src={heroImage}
              alt={heroImageAlt ?? ''}
              transition:name={`post-hero-${post.id}`}
            />
          </figure>
        )
      }
    </PageHero>

    <div class="article-body">
      <Content />
    </div>

    <footer class="article-footer">
      <p class="kicker">{t.followKicker}</p>
      <h2 class="article-footer-title">{t.followTitle}</h2>
      <Waitlist id={`article-${post.id}`} lang={lang} />
      <p class="article-footer-back"><a href={blogHref}>{t.allPosts}</a></p>
    </footer>
  </article>
</SiteLayout>

<style>
  .article-byline {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: center;
    margin-top: 30px;
    font-family: var(--mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--ink-mute);
  }
  /* The name carries the line; the date is the footnote to it. */
  .article-author {
    color: var(--ink);
    font-weight: 700;
  }
  /* A brass pip between the two, so name and date read as one line rather than
     two columns that happen to be next to each other. Drawn on the date so the
     byline stays three elements, and it disappears with the date if a post
     ever has none. */
  .article-byline time::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--brass-bright);
    vertical-align: middle;
    margin-right: 14px;
  }
  /* The pip is the only thing on this line that is a painted shape rather than
     text, so it is the only thing a forced palette drops to nothing. */
  @media (forced-colors: active) {
    .article-byline time::before {
      background: CanvasText;
    }
  }

  /* Square file, circular crop: the registry in src/lib/authors.ts promises
     square portraits so this rule does not have to know whose face it is.
     The hairline keeps a light-cornered photograph off the paper without
     putting a frame around someone's head. */
  .article-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 1px var(--line),
      var(--shadow-sm);
  }

  .article-figure {
    max-width: 980px;
    margin: var(--space-xl) auto 0;
    padding-inline: var(--gutter);
  }
  .article-figure img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
  }

  /* Rendered markdown. Descendants come from <Content />, so they are outside
     this component's scope and need :global(). */
  .article-body {
    max-width: var(--container-text);
    margin-inline: auto;
    padding: var(--space-2xl) var(--gutter) var(--space-4xl);
    font-size: 1.08rem;
  }
  .article-body :global(h2) {
    font-size: 1.7rem;
    margin-top: 2em;
  }
  .article-body :global(h3) {
    margin-top: 1.8em;
  }
  /* Drop cap on the opening paragraph. */
  .article-body :global(> p:first-child)::first-letter {
    font-family: var(--display);
    font-variation-settings:
      'opsz' 96,
      'wght' 680;
    font-size: 3.4em;
    float: left;
    line-height: 0.82;
    padding-right: 10px;
    color: var(--green);
  }
  .article-body :global(blockquote) {
    margin: 1.8em 0;
    padding: 4px 0 4px 24px;
    border-left: 3px solid var(--brass-bright);
    font-family: var(--display);
    font-variation-settings:
      'opsz' 40,
      'wght' 540;
    font-size: 1.25em;
    line-height: 1.4;
    color: var(--green);
  }
  .article-body :global(blockquote p) {
    margin: 0;
  }
  .article-body :global(img) {
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--line);
    margin-block: 1.6em;
  }
  .article-body :global(hr) {
    border: none;
    height: 2px;
    width: 64px;
    background: var(--brass-bright);
    margin: 2.6em auto;
  }
  .article-body :global(code) {
    font-family: var(--mono);
    font-size: 0.85em;
    background: var(--paper-warm);
    padding: 2px 6px;
    border-radius: 5px;
  }
  .article-body :global(pre) {
    background: var(--green-deep);
    color: #e8efe9;
    padding: 20px 24px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: 0.86em;
  }
  .article-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .article-footer {
    max-width: var(--container-text);
    margin-inline: auto;
    padding: 0 var(--gutter) var(--space-3xl);
  }
  .article-footer-title {
    font-size: 1.5rem;
  }
  .article-footer-back {
    margin-top: 28px;
  }

  /* Reading progress bar: scroll-driven, progressive enhancement. */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--brass-bright);
    transform-origin: 0 50%;
    scale: 0 1;
    z-index: 60;
    pointer-events: none;
  }
  @supports (animation-timeline: scroll()) {
    .reading-progress {
      animation: reading-progress linear both;
      animation-timeline: scroll(root block);
    }
    @keyframes reading-progress {
      from {
        scale: 0 1;
      }
      to {
        scale: 1 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      display: none;
    }
  }
</style>
