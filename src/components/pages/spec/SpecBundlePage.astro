---
// /spec/deck-bundle/ - the container layer.
//
// The page people arrive at when they ask "so is it the zip, then". It leads
// with the archive listing, because seeing four entries in a fixed order
// explains the format faster than a paragraph about it can.
import SpecShell from '@/components/spec/SpecShell.astro';
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import CodeBlock from '@/components/spec/CodeBlock.astro';
import SpecReference from '@/components/spec/SpecReference.astro';
import { ui, type Lang } from '@/i18n';
import { withSpec, EXAMPLE_BUNDLE_LAYOUT, EXAMPLE_MANIFEST, BUNDLE_ENTRIES } from '@/lib/spec';
import { inlineCode } from '@/lib/inline';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].spec.bundle;

const prose = (text: string) => inlineCode(withSpec(text));
---

<SpecShell
  lang={lang}
  page="deck-bundle"
  title={t.metaTitle}
  description={t.metaDescription}
  heroKicker={t.heroKicker}
  heroTitle={t.heroTitle}
  heroIntro={t.heroIntro}
>
  <!-- ============ layout ============ -->
  <Section>
    <div class="spec-prose" data-reveal>
      {t.introBody.map((p) => <p set:html={prose(p)} />)}
      <h2>{t.layoutTitle}</h2>
      {t.layoutBody.map((p) => <p set:html={prose(p)} />)}
    </div>
    <CodeBlock code={EXAMPLE_BUNDLE_LAYOUT} label={t.layoutTitle} />
    <dl class="spec-defs">
      {
        BUNDLE_ENTRIES.map((e) => (
          <div>
            <dt>
              <code>{e.entry}</code>
            </dt>
            <dd set:html={prose(t.layoutNotes[e.key] ?? '')} />
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- ============ manifest ============ -->
  <Section variant="tint">
    <div class="spec-prose" data-reveal>
      <h2>{t.manifestTitle}</h2>
      {t.manifestBody.map((p) => <p set:html={prose(p)} />)}
    </div>
    <CodeBlock code={EXAMPLE_MANIFEST} />
    <SpecReference lang={lang} href="/docs/reference/deck-bundle/" note={t.manifestRefNote} />
  </Section>

  <!-- ============ guarantees ============ -->
  <Section>
    <SectionHead title={t.guaranteesTitle} lead={t.guaranteesLead} />
    <ul class="guarantees">
      {
        t.guarantees.map((g, i) => (
          <li data-reveal data-reveal-delay={Math.min(i, 4) * 60}>
            <h3>{g.title}</h3>
            <p set:html={prose(g.body)} />
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ============ import + gaps ============ -->
  <Section variant="tint">
    <div class="spec-prose" data-reveal>
      <h2>{t.importTitle}</h2>
      {t.importBody.map((p) => <p set:html={prose(p)} />)}

      <h2>{t.gapsTitle}</h2>
      {t.gapsBody.map((p) => <p set:html={prose(p)} />)}
    </div>
  </Section>
</SpecShell>

<style>
  .guarantees {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 800px) {
    .guarantees {
      grid-template-columns: 1fr 1fr;
      gap: 1.1rem;
    }
  }
  .guarantees li {
    padding: 1.2rem 1.4rem 1.3rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .guarantees h3 {
    margin: 0 0 0.45rem;
    font-size: 1.1rem;
    font-variation-settings: 'wght' 620;
    letter-spacing: -0.015em;
  }
  .guarantees p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }
</style>
