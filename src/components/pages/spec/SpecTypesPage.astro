---
// /spec/slide-types/ - the registry, as a grid of cards.
//
// Every type on this page comes out of src/data/slide-types.json, generated from
// the core registry. Nothing here is transcribed, which is the whole point: the
// last hand-maintained version of this list said 36 in one place, 38 in another
// and 44 in a third.
//
// Detail is a native <details> disclosure rather than a modal or a route. It
// keeps the grid scannable, needs no JavaScript to open, and a reader who lands
// here from a search engine gets the whole registry in one document.
import SpecShell from '@/components/spec/SpecShell.astro';
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import Schematic from '@/components/spec/Schematic.astro';
import SpecReference from '@/components/spec/SpecReference.astro';
import { ui, localizePath, type Lang } from '@/i18n';
import { withSpec, liveSchemaUrl, LIVE_INSTANCE } from '@/lib/spec';
import { withFacts } from '@/lib/facts';
import { inlineCode } from '@/lib/inline';
import {
  slideTypes,
  globalFields,
  deprecatedTypes,
  slideStructures,
  typesWithStructure,
  repeatingFields,
  structureCoverage,
  slideRuntimes,
  typesWithRuntime,
  type SlideType,
  type SlideTypeField,
} from '@/lib/slideTypes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].spec.types;

const prose = (text: string) => inlineCode(withSpec(text));
const active = slideTypes.filter((type) => !type.deprecated);

/**
 * The registry, grouped by the `structure` facet rather than by the editor's
 * picker categories. Both live in the generated data; this page deliberately
 * reads the one core guards with a test, because a spec page's job is to state
 * a contract an implementor can build against, and "Basics / Media / Layouts"
 * is not one - it mixes familiarity, payload and runtime behaviour.
 *
 * Only structures that actually hold an active type are rendered, so retiring
 * the last member of one takes its section away without anybody editing this.
 */
const structureGroups = slideStructures
  .map((s) => ({ ...s, types: typesWithStructure(s.name) }))
  .filter((s) => s.types.length > 0);

/** The claim the conformance table is worth making: the two biggest shapes. */
const headlineStructures = structureCoverage(['singleton', 'collection']);

/** A field's limit, or an em rule when it has none. */
const limitOf = (f: SlideTypeField) => (f.maxLength ? String(f.maxLength) : t.noLimit);

/** `tabular` and `dataset` hold exactly one type, so "1 types" is reachable. */
const countLabel = (n: number) =>
  (n === 1 ? t.structureCountOne : t.structureCountLabel).replace('{n}', String(n));
---

<SpecShell
  lang={lang}
  page="slide-types"
  title={t.metaTitle}
  description={t.metaDescription}
  heroKicker={t.heroKicker}
  heroTitle={t.heroTitle}
  heroIntro={t.heroIntro}
>
  <!-- ============ the framing ============ -->
  <Section>
    <dl class="ty-stats" data-reveal>
      {
        t.stats.map((s) => (
          <div>
            <dt>{withFacts(s.value)}</dt>
            <dd>{s.label}</dd>
          </div>
        ))
      }
    </dl>
    <div class="spec-prose ty-intro" data-reveal data-reveal-delay="80">
      {t.introBody.map((p) => <p set:html={prose(p)} />)}
    </div>
  </Section>

  <!-- ============ the facet ============ -->
  <Section>
    <SectionHead title={t.structureTitle} />
    <div class="spec-prose" data-reveal>
      {t.structureBody.map((p) => <p set:html={prose(p)} />)}
    </div>
    <!-- Quoted policy from core's own reference page, kept verbatim: it is the
         rule that decides where a type boundary is, and a paraphrase on this
         side would be a second wording of a decision that has one. -->
    <blockquote class="ty-rule" data-reveal>
      <p>{t.structureRule}</p>
      <cite>{t.structureRuleSource}</cite>
    </blockquote>
  </Section>

  <!-- ============ the second facet ============ -->
  <!-- Deliberately short and deliberately here, beside `structure`, rather than
       folded into the cards: the two facets are peers, and the useful thing
       about this one is how lopsided it is. Most of the catalogue asks nothing
       of a session at all, which is what makes a server-free reader realistic. -->
  <Section>
    <SectionHead title={t.runtimeTitle} />
    <div class="spec-prose" data-reveal>
      {t.runtimeBody.map((p) => <p set:html={prose(p)} />)}
    </div>
    <dl class="spec-defs ty-runtimes" data-reveal>
      {
        slideRuntimes.map((r) => (
          <div>
            <dt>
              {t.runtimeLabels[r.name] ?? r.name} <code>{r.name}</code>
              <span class="ty-runtime-count">{countLabel(typesWithRuntime(r.name).length)}</span>
            </dt>
            <dd set:html={prose(t.runtimeContracts[r.name] ?? r.meaning)} />
          </div>
        ))
      }
    </dl>
    <p class="spec-note" data-reveal set:html={prose(t.runtimeEdge)} />
  </Section>

  <!-- ============ the registry, by structure ============ -->
  <Section variant="tint" id="registry">
    <!-- The toolbar only exists with scripting on. Rendering a filter button
         that does nothing is worse than not offering it: without it the page is
         a complete list, which is a fine thing to be. -->
    <div class="ty-toolbar" data-types-toolbar hidden>
      <div class="ty-filter ty-filter--toggle">
        <button type="button" class="ty-toggle" aria-pressed="false" data-audience-filter>
          {t.filterAudienceLabel}
        </button>
        <p class="ty-hint">{t.filterAudienceHint}</p>
      </div>

      <!-- The template lives on the element rather than in the script so the
           sentence stays in the locale files with the rest of the copy. -->
      <p class="ty-count" role="status" data-types-count data-template={t.resultCount}></p>
    </div>

    {
      structureGroups.map((group) => (
        <section class="ty-group" data-structure-section={group.name}>
          <header class="ty-group-head" data-reveal>
            <h2>
              {t.structureLabels[group.name] ?? group.name}
              <span class="ty-group-count">{countLabel(group.types.length)}</span>
            </h2>
            {/* Core's own one-line meaning, then the contract a reader can
                build against. The first is generated, the second is copy. */}
            <p class="ty-group-meaning">{group.meaning}</p>
            <p class="ty-group-contract" set:html={prose(t.structureContracts[group.name] ?? '')} />
            {t.structureCaveats[group.name] && (
              <p class="ty-group-caveat" set:html={prose(t.structureCaveats[group.name])} />
            )}
          </header>

          <ul class="ty-grid" data-types-grid>
            {group.types.map((type: SlideType) => (
              <li class="ty-item" data-audience={String(type.audience)}>
                <details class="ty-card">
                  <summary>
                    <Schematic spec={type.schematic} class="ty-glyph" />
                    <span class="ty-head">
                      <span class="ty-label">{type.label}</span>
                      {type.audience && <span class="ty-badge">{t.audienceBadge}</span>}
                    </span>
                    <code class="ty-key">{type.name}</code>
                    {type.description && <span class="ty-desc">{type.description}</span>}
                    <span class="ty-more">{t.detailsLabel}</span>
                  </summary>

                  <div class="ty-detail">
                    {type.fields.length > 0 && (
                      <>
                        <h3>{t.fieldsTitle}</h3>
                        <div class="spec-tablewrap">
                          <table class="spec-table ty-fields">
                            <thead>
                              <tr>
                                <th scope="col">{t.colKey}</th>
                                <th scope="col">{t.colType}</th>
                                <th scope="col">{t.colRequired}</th>
                                <th scope="col">{t.colLimit}</th>
                                <th scope="col">{t.colOptions}</th>
                              </tr>
                            </thead>
                            <tbody>
                              {type.fields.map((f) => (
                                <tr>
                                  <th scope="row">{f.key}</th>
                                  <td>{f.type}</td>
                                  <td>{f.required ? t.required : t.optional}</td>
                                  <td>{limitOf(f)}</td>
                                  <td>
                                    {f.options ? (
                                      f.options.map((o) => o.value).join(', ')
                                    ) : f.itemFields ? (
                                      <>
                                        {t.itemFieldsNote}{' '}
                                        {f.itemFields.map((sub) => sub.key).join(', ')}
                                      </>
                                    ) : (
                                      t.noLimit
                                    )}
                                  </td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </>
                    )}

                    {type.layoutVariants.length > 0 && (
                      <>
                        <h3>{t.variantsTitle}</h3>
                        <ul class="ty-variants">
                          {type.layoutVariants.map((v) => (
                            <li>
                              <Schematic spec={v.schematic ?? type.schematic} />
                              <span>{v.label}</span>
                            </li>
                          ))}
                        </ul>
                      </>
                    )}

                    {(type.bestFor.length > 0 || type.notFor.length > 0) && (
                      <div class="ty-fit">
                        {type.bestFor.length > 0 && (
                          <div>
                            <h3>{t.bestForTitle}</h3>
                            <ul>
                              {type.bestFor.map((line) => (
                                <li>{line}</li>
                              ))}
                            </ul>
                          </div>
                        )}
                        {type.notFor.length > 0 && (
                          <div>
                            <h3>{t.notForTitle}</h3>
                            <ul>
                              {type.notFor.map((line) => (
                                <li>{line}</li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </div>
                    )}

                    <p class="ty-meta">
                      <span>
                        {/* The repeating array, named. This is where the group's
                        contract stops being a claim about twelve types and
                        becomes the one array a reader actually walks - and
                        where a type that declares a shape it does not carry
                        shows up as "scalar fields only". */}
                        {t.structureItemsLabel}:{' '}
                        {repeatingFields(type).length > 0 ? (
                          repeatingFields(type).map((f) => <code>{f.key}[]</code>)
                        ) : (
                          <em>{t.structureNoItems}</em>
                        )}
                      </span>
                      <span>
                        {t.identityLabel}: <code>{type.id}</code>
                      </span>
                      {/* The two facets a type declares beyond its structure,
                          and the promise attached to its name. All three are
                          generated, and all three are what /spec/conformance/
                          reasons about - a reader deciding what to build looks
                          at the type, not at the argument. */}
                      <span>
                        {t.tierLabel}: <code>{type.tier}</code>
                      </span>
                      {type.runtime && (
                        <span>
                          {t.runtimeLabel}: <code>{type.runtime}</code>
                          {/* The sub-declaration a `live` type carries, in
                              brackets because it qualifies the value rather
                              than standing beside it as a second facet. */}
                          {type.interaction && (
                            <>
                              {' '}
                              (<code>{type.interaction}</code>)
                            </>
                          )}
                        </span>
                      )}
                      {type.fallback && (
                        <span>
                          {t.fallbackLabel}: <code>{type.fallback}</code>
                        </span>
                      )}
                      <a href={liveSchemaUrl(type.name)} target="_blank" rel="noopener">
                        {t.schemaLinkLabel}
                      </a>
                    </p>
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <p class="ty-empty" data-types-empty hidden>{t.emptyResult}</p>
  </Section>

  <!-- ============ conformance ============ -->
  <Section>
    <SectionHead title={t.conformanceTitle} />
    <div class="spec-prose" data-reveal>
      {t.conformanceBody.map((p) => <p set:html={prose(p)} />)}
    </div>
    <div class="spec-tablewrap" data-reveal>
      <table class="spec-table">
        <thead>
          <tr>
            <th scope="col">{t.conformanceColStructure}</th>
            <th scope="col">{t.conformanceColTypes}</th>
            <th scope="col">{t.conformanceColClaim}</th>
          </tr>
        </thead>
        <tbody>
          {
            structureGroups.map((group) => (
              <tr>
                <th scope="row">
                  <code>{group.name}</code>
                </th>
                <td>{group.types.length}</td>
                <td>{t.conformanceClaim.replace('{n}', String(group.types.length))}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <!-- The worked example is still here, because it is the answer with
         scripting off and because one concrete sentence beats a control nobody
         clicks. The claim builder on /spec/conformance/ is the same sentence for
         any combination, so this links there rather than restating it. -->
    <div class="ty-claim" data-reveal>
      <h3>{t.conformanceExampleTitle}</h3>
      <p
        set:html={prose(
          t.conformanceExample
            .replace('{n}', String(headlineStructures))
            .replace('{total}', String(active.length))
        )}
      />
      <p class="ty-claim-more">
        <a href={localizePath('/spec/conformance/', lang)}>
          {t.conformanceLinkLabel}<span aria-hidden="true"> →</span>
        </a>
      </p>
    </div>
  </Section>

  <!-- ============ the shared fields ============ -->
  <Section>
    <SectionHead title={t.globalTitle} />
    <div class="spec-prose" data-reveal>
      {t.globalBody.map((p) => <p set:html={prose(p)} />)}
    </div>
    <div class="spec-tablewrap" data-reveal>
      <table class="spec-table">
        <thead>
          <tr>
            <th scope="col">{t.colKey}</th>
            <th scope="col">{t.colType}</th>
            <th scope="col">{t.colOptions}</th>
          </tr>
        </thead>
        <tbody>
          {
            globalFields.map((f) => (
              <tr>
                <th scope="row">{f.key}</th>
                <td>{f.type}</td>
                <td>{f.options ? f.options.map((o) => o.value).join(', ') : t.noLimit}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Section>

  <!-- ============ retired types ============ -->
  <Section variant="tint">
    <SectionHead title={t.deprecatedTitle} />
    <div class="spec-prose" data-reveal>
      {t.deprecatedBody.map((p) => <p set:html={prose(p)} />)}
    </div>
    <ul class="ty-retired" data-reveal>
      {
        deprecatedTypes.map((type) => (
          <li>
            <code>{type.name}</code>
            <span>{type.label}</span>
            <span class="ty-badge ty-badge--retired">{t.deprecatedBadge}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ============ provenance ============ -->
  <Section>
    <div class="spec-prose" data-reveal>
      <h2>{t.provenanceTitle}</h2>
      {t.provenanceBody.map((p) => <p set:html={prose(p)} />)}
      <p><code>{LIVE_INSTANCE}/api/v1/schema/slide-types/&lt;type&gt;.json</code></p>
    </div>
    <SpecReference lang={lang} href="/docs/reference/slide-types/" note={t.referenceNote} />
  </Section>
</SpecShell>

<script>
  // One filter left: the audience toggle. The structure radiogroup that used to
  // sit beside it is gone because the page now groups by structure, and a
  // control that hides five of six sections is the same statement twice.
  //
  // That grouping is what makes this script walk sections rather than one grid:
  // hiding every card in a group has to take the group's heading and contract
  // with it, or the page keeps a promise about types it is no longer showing.
  function initTypeFilters() {
    const toolbar = document.querySelector<HTMLElement>('[data-types-toolbar]');
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-structure-section]'));
    if (!toolbar || !sections.length || toolbar.dataset.bound) return;
    toolbar.dataset.bound = 'true';
    toolbar.hidden = false;

    const audienceBtn = toolbar.querySelector<HTMLButtonElement>('[data-audience-filter]');
    const countEl = toolbar.querySelector<HTMLElement>('[data-types-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-types-empty]');
    const template = countEl?.dataset.template ?? '';

    let audienceOnly = false;

    const apply = () => {
      let shown = 0;
      for (const section of sections) {
        let inSection = 0;
        for (const item of section.querySelectorAll<HTMLElement>('.ty-item')) {
          const matches = !audienceOnly || item.dataset.audience === 'true';
          item.hidden = !matches;
          if (matches) inSection += 1;
        }
        section.hidden = inSection === 0;
        shown += inSection;
      }
      if (countEl) countEl.textContent = template.replace('{n}', String(shown));
      if (emptyEl) emptyEl.hidden = shown > 0;
    };

    audienceBtn?.addEventListener('click', () => {
      audienceOnly = !audienceOnly;
      audienceBtn.setAttribute('aria-pressed', String(audienceOnly));
      apply();
    });

    apply();
  }

  initTypeFilters();
  document.addEventListener('astro:page-load', initTypeFilters);
</script>

<style>
  /* ---------- the stat row ---------- */
  .ty-stats {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .ty-stats > div {
    flex: 1 1 13rem;
    min-width: 0;
    padding: 1rem 1.4rem;
    border-right: 1px solid var(--line);
  }
  .ty-stats > div:first-child {
    padding-left: 0;
  }
  .ty-stats > div:last-child {
    border-right: 0;
  }
  .ty-stats dt {
    font-family: var(--display);
    font-variation-settings: 'wght' 660;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--green);
    font-variant-numeric: tabular-nums;
  }
  .ty-stats dd {
    margin: 0.45rem 0 0;
    font-family: var(--mono);
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--ink-mute);
  }
  .ty-intro {
    margin-top: var(--space-lg);
  }

  /* ---------- toolbar ---------- */
  .ty-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.2rem 2rem;
    margin-bottom: var(--space-lg);
  }
  .ty-hint {
    display: block;
    max-width: 22rem;
    margin: 0.5rem 0 0;
    font-family: var(--body);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-mute);
  }
  .ty-toggle {
    font-family: var(--body);
    font-size: 0.88rem;
    padding: 0.35rem 0.85rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink-soft);
    cursor: pointer;
    transition:
      border-color var(--dur-micro) ease,
      background-color var(--dur-micro) ease;
  }
  .ty-toggle:hover {
    border-color: var(--green-bright);
  }
  /* Pressed state is a filled pill AND a bolder weight, because a state told
     apart only by a background colour vanishes when a reader brings their own. */
  .ty-toggle[aria-pressed='true'] {
    background: var(--green);
    border-color: var(--green);
    color: #fff;
    font-weight: 600;
  }
  .ty-count {
    margin: 0;
    align-self: flex-end;
    font-family: var(--mono);
    font-size: var(--step--3);
    color: var(--ink-mute);
  }
  @media (forced-colors: active) {
    .ty-toggle[aria-pressed='true'] {
      border-color: Highlight;
      border-width: 3px;
    }
  }

  /* ---------- the quoted rule ---------- */
  .ty-rule {
    max-width: 42rem;
    margin: var(--space-md) 0 0;
    padding-left: 1.2rem;
    border-left: 3px solid var(--brass);
  }
  .ty-rule p {
    margin: 0;
    font-family: var(--display);
    font-variation-settings: 'wght' 520;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink);
  }
  .ty-rule cite {
    display: block;
    margin-top: 0.7rem;
    font-style: normal;
    font-family: var(--mono);
    font-size: var(--step--3);
    color: var(--ink-mute);
  }

  /* ---------- a structure group ---------- */
  .ty-group + .ty-group {
    margin-top: var(--space-lg);
  }
  .ty-group-head {
    max-width: 46rem;
    margin-bottom: var(--space-md);
  }
  .ty-group-head h2 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }
  .ty-group-count {
    font-family: var(--mono);
    font-size: var(--step--3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
    font-variant-numeric: tabular-nums;
  }
  .ty-group-meaning {
    margin: 0.5rem 0 0;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--brass-text);
  }
  .ty-group-contract {
    margin: 0.7rem 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  /* The honest part. A group whose members do not all keep to the contract says
     so here rather than rounding up, so the shape stays checkable. */
  .ty-group-caveat {
    margin: 0.8rem 0 0;
    padding: 0.7rem 0.9rem;
    border-left: 3px solid var(--brass);
    background: var(--paper-warm);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-mute);
  }

  /* ---------- the conformance claim ---------- */
  .ty-claim {
    max-width: 46rem;
    margin: var(--space-md) 0 0;
    padding: 1.1rem 1.3rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .ty-claim h3 {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--step--3);
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .ty-claim-more {
    margin-top: 0.9rem;
  }
  .ty-claim-more a {
    font-variation-settings: 'wght' 600;
    white-space: nowrap;
  }
  .ty-claim p {
    margin: 0.7rem 0 0;
    font-family: var(--mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink);
  }

  /* The runtime vocabulary reuses the shared definition rows; only the two
     things a plain <dt> cannot carry are added - the raw value beside its label,
     and how many types declare it. */
  .ty-runtimes dt code {
    font-family: var(--mono);
    font-size: 0.8em;
    font-weight: 400;
    color: var(--ink-mute);
  }
  .ty-runtime-count {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--mono);
    font-size: var(--step--3);
    font-weight: 400;
    color: var(--brass-text);
  }

  /* ---------- the grid ---------- */
  .ty-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
  /* An open card takes the full row: its field table needs the width, and a card
     that grows inside one grid cell pushes its neighbours around. */
  .ty-item:has(details[open]) {
    grid-column: 1 / -1;
  }

  .ty-card {
    height: 100%;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .ty-card[open] {
    border-color: var(--green-bright);
