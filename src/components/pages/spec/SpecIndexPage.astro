---
// /spec/ - the front door. Answers three questions in order: what is it, why
// does it exist, and what is settled about it.
//
// The "status" section at the foot is the point of the page. A format offered as
// a standard that will not say what it promises, under what licence, and how far
// its conformance goes is a marketing page with a schema attached.
import SpecShell from '@/components/spec/SpecShell.astro';
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
import Button from '@/components/ui/Button.astro';
import SpecIcon from '@/components/spec/SpecIcon.astro';
import type { SpecIconName } from '@/components/spec/icons';
import { ui, type Lang } from '@/i18n';
import { withSpec, CORE_REPO } from '@/lib/spec';
import { inlineCode } from '@/lib/inline';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].spec.index;
const shared = ui[lang].spec.shared;

const prose = (text: string) => inlineCode(withSpec(text));

// Icons by position, because the copy carries no ids and both lists are a fixed
// ordered set - their order IS the structure, in every language. Structural, so
// it sits here rather than in the locale files. A shorter array simply leaves
// the tail without an icon instead of breaking the card.
const LAYER_ICONS: SpecIconName[] = ['file-code', 'package'];
const CLAIM_ICONS: SpecIconName[] = ['split', 'braces', 'bot', 'git-branch', 'shield-check'];
---

<SpecShell
  lang={lang}
  page="index"
  title={t.metaTitle}
  description={t.metaDescription}
  heroKicker={t.heroKicker}
  heroTitle={t.heroTitle}
  heroIntro={t.heroIntro}
>
  <!-- ============ the two layers ============ -->
  <Section>
    <SectionHead title={t.layersTitle} lead={t.layersLead} />
    <div class="layers">
      {
        t.layers.map((layer, i) => (
          <article class="layer" data-reveal data-reveal-delay={i * 80}>
            {LAYER_ICONS[i] && (
              <p class="layer-icon">
                <SpecIcon name={LAYER_ICONS[i]} size={24} />
              </p>
            )}
            <p class="layer-badge">{layer.badge}</p>
            <h3>{layer.name}</h3>
            <p class="layer-what">{layer.what}</p>
            <p class="layer-body" set:html={prose(layer.body)} />
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ============ why it is written down ============ -->
  <Section variant="tint">
    <div class="spec-prose" data-reveal>
      <h2>{t.whyTitle}</h2>
      {t.whyBody.map((p) => <p set:html={prose(p)} />)}
    </div>
  </Section>

  <!-- ============ the five claims ============ -->
  <Section>
    <SectionHead title={t.claimsTitle} lead={t.claimsLead} />
    <ol class="claims">
      {
        t.claims.map((claim, i) => (
          <li data-reveal data-reveal-delay={Math.min(i, 4) * 60}>
            <p class="claim-mark">
              {CLAIM_ICONS[i] && <SpecIcon name={CLAIM_ICONS[i]} size={18} />}
              <span>{String(i + 1).padStart(2, '0')}</span>
            </p>
            <h3>{claim.title}</h3>
            <p set:html={prose(claim.body)} />
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ============ status ============ -->
  <Section variant="tint">
    <SectionHead title={t.statusTitle} lead={t.statusLead} />
    <dl class="spec-defs">
      {
        t.status.map((row) => (
          <div>
            <dt>{withSpec(row.term)}</dt>
            <dd set:html={prose(row.def)} />
          </div>
        ))
      }
    </dl>
    <p class="status-cta">
      <Button href={CORE_REPO} variant="ghost" external>
        {shared.codeLabel}
      </Button>
    </p>
  </Section>
</SpecShell>

<style>
  /* ---------- the two layers ---------- */
  /* Side by side, because the whole point is that they are two things and one
     contains the other. Stacked they read as a sequence of steps. */
  .layers {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  @media (min-width: 820px) {
    .layers {
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem;
    }
  }
  .layer {
    padding: 1.6rem 1.7rem 1.8rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  /* The one thing on the card that says "format" versus "package" before a word
     has been read, so it gets a plate of its own rather than riding along with
     the eyebrow as a bullet. A document with code in it, and a sealed box. */
  .layer-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0 0 1rem;
    border-radius: var(--radius-sm);
    background: var(--green-wash);
    color: var(--green);
  }
  @media (forced-colors: active) {
    .layer-icon {
      border: 1px solid CanvasText;
    }
  }
  .layer-badge {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--step--3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .layer h3 {
    margin: 0.6rem 0 0.3rem;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }
  .layer-what {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--green);
  }
  .layer-body {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  /* ---------- claims ---------- */
  /* Numbered: they are five separate assertions and the reader benefits from
     being able to point at one of them. */
  .claims {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    max-width: 54rem;
  }
  .claims li {
    padding: 1.2rem 1.4rem 1.3rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  /* The number stays: five separate assertions, and a reader benefits from
     being able to point at one of them. It rides with the icon as a single
     mark rather than as a second thing competing for the same corner. */
  .claim-mark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.7rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--brass-text);
  }
  .claim-mark :global(svg) {
    flex: 0 0 auto;
    color: var(--green);
  }
  .claims h3 {
    margin: 0 0 0.45rem;
    font-size: 1.1rem;
    font-variation-settings: 'wght' 620;
    letter-spacing: -0.015em;
  }
  .claims p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  /* ---------- status ---------- */
  .status-cta {
    margin: var(--space-md) 0 0;
  }
</style>
