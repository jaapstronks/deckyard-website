---
// Starlight component override: give every docs page its own OG card.
//
// Starlight emits the rest of the social metadata itself (og:title, og:type,
// twitter:card) but has no per-page image, only the one static entry you can
// put in the `head` config. So the default head is rendered untouched and the
// image tags are appended here, resolved through the same registry the
// marketing pages use (src/lib/og/targets.ts).
import Default from '@astrojs/starlight/components/Head.astro';
import { ogImageForPath, ogPathFor } from '@/lib/og/targets';

const siteUrl = 'https://deckyard.eu';
const path = (await ogImageForPath(Astro.url.pathname)) ?? ogPathFor('/docs');
const ogImageUrl = new URL(path, siteUrl).href;
const title = Astro.locals.starlightRoute.entry.data.title;
---

<Default><slot /></Default>

<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:image" content={ogImageUrl} />
