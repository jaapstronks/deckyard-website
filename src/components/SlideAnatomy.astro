---
// Explainer: how raw material becomes an on-brand slide, and why the slide type
// is the control point rather than an inconvenience.
//
// Three zones stacked full width:
//   1. Raw input      - a pile of things from different places (doc, sheet,
//                       note, image library). The one feeding the current slide
//                       type comes forward.
//   2. Structuring    - by hand, via the API, or via MCP. Three routes, one
//                       gate: all of them validate against the same type.
//   3. The slide      - two independent controls on one slide: the type (what
//                       it means) and the house style (how it looks). Changing
//                       one never touches the other; that is the whole thesis.
//
// The demo content is a lemonade stand reported on in stiff corporate register,
// deliberately absurd so nobody reads the example as a claim about Deckyard.
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].anatomy;

interface FieldDef {
  key: string;
  type: string;
  required?: boolean;
  ordered?: boolean;
  min?: number;
  max?: number;
  maxLen?: number;
  sub?: string;
  /** Passages in the source material this field was drawn from. Empty means the
   *  field is an authoring decision, not something the source contains. */
  spans: string[];
}

// Field vocabulary per slide type. Structural, so not translated: the keys,
// types, required flags and limits mirror the real definitions in the engine
// (shared/slide-types/types/*.js). Note that image-slide's `alt` is genuinely
// optional there - `imageRole` is what carries the accessibility decision.
const FIELDS: Record<string, FieldDef[]> = {
  'timeline-slide': [
    { key: 'title', type: 'string', maxLen: 120, spans: ['h1'] },
    {
      key: 'items',
      type: 'items',
      required: true,
      ordered: true,
      min: 2,
      max: 10,
      sub: 'date · title · text',
      spans: ['t1', 'n1', 't2', 'n2', 't3', 'n3', 't4', 'n4'],
    },
  ],
  'chart-slide': [
    { key: 'title', type: 'string', required: true, maxLen: 120, spans: ['sh'] },
    { key: 'chartType', type: 'enum', required: true, sub: 'bar · line · pie', spans: [] },
    { key: 'data', type: 'csv', required: true, spans: ['c1', 'c2', 'c3'] },
  ],
  'quote-slide': [
    { key: 'quote', type: 'string', required: true, maxLen: 400, spans: ['q1'] },
    { key: 'authorName', type: 'string', required: true, maxLen: 80, spans: ['q2'] },
    { key: 'authorTitle', type: 'string', required: true, maxLen: 120, spans: ['q3'] },
  ],
  'image-slide': [
    { key: 'image', type: 'image', spans: ['i1'] },
    { key: 'alt', type: 'string', maxLen: 180, spans: ['i2'] },
    { key: 'imageRole', type: 'enum', sub: 'content · decorative', spans: [] },
    { key: 'caption', type: 'string', maxLen: 160, spans: [] },
  ],
};

// Which raw source each slide type draws on. Drives which card comes forward.
const SOURCE_OF: Record<string, string> = {
  'timeline-slide': 'doc',
  'chart-slide': 'sheet',
  'quote-slide': 'note',
  'image-slide': 'library',
};

// Slide-type glyphs for the "add a slide" mock, in the same order as the
// picker options in the dictionary. Schematic on purpose: this is a diagram of
// a type picker, not a screenshot of one.
const GLYPHS = [
  // title
  '<rect x="4" y="7" width="16" height="3.2" rx="1.6"/><rect x="4" y="13" width="9" height="2.4" rx="1.2"/>',
  // timeline
  '<path d="M3 13h18" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="6" cy="13" r="2"/><circle cx="12" cy="13" r="2"/><circle cx="18" cy="13" r="2"/>',
  // chart
  '<rect x="4" y="12" width="3.6" height="7" rx="1"/><rect x="10.2" y="8" width="3.6" height="11" rx="1"/><rect x="16.4" y="5" width="3.6" height="14" rx="1"/>',
  // quote
  '<path d="M5 16c0-4 2-6.6 5-7.4l.6 1.8C9 11 8.4 11.9 8.4 13H11v5H5zm7.6 0c0-4 2-6.6 5-7.4l.6 1.8c-1.6.6-2.2 1.5-2.2 2.6H18.6v5h-6z"/>',
  // image
  '<rect x="3.5" y="5.5" width="17" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="9" cy="10.2" r="1.6"/><path d="M5.5 17.2l4.2-4.2 3 3 2.6-2.4 3.4 3.6z"/>',
];

// The record every route ends up producing. Built from the same demo content
// the slide in zone 3 renders, so the JSON here and the slide down there can
// never drift apart. The shape is structural; only the values are translated.
const timelineType = t.types.find((x) => x.id === 'timeline-slide');
const RECORD = [
  '{',
  '  <span class="k">"type"</span>: <span class="s">"timeline-slide"</span>,',
  '  <span class="k">"content"</span>: {',
  `    <span class="k">"title"</span>: <span class="s">"${timelineType?.title ?? ''}"</span>,`,
  '    <span class="k">"items"</span>: [',
  ...(timelineType?.items ?? [])
    .slice(0, 2)
    .map(
      (it) =>
        `      { <span class="k">"date"</span>: <span class="s">"${it.date}"</span>, <span class="k">"title"</span>: <span class="s">"${it.title}"</span> },`
    ),
  '      …',
  '    ]',
  '  }',
  '}',
].join('\n');

// Abstract tiles standing in for an image library. Deliberately schematic: this
// is a diagram of a picker, not a photo montage.
const TILES = [
  'linear-gradient(150deg,#f4c04e,#d98a1f 55%,#7a4a10)',
  'linear-gradient(150deg,#a8c8e8,#4a76a8 55%,#1f3b5c)',
  'linear-gradient(150deg,#c9d8a8,#6f9448 55%,#2f4520)',
  'linear-gradient(150deg,#e8b9a0,#b8663c 55%,#5c2f18)',
  'linear-gradient(150deg,#cfd6d9,#7d8f97 55%,#39464c)',
  'linear-gradient(150deg,#d8c4e0,#8a63a8 55%,#42284f)',
];
---

<div class="anatomy">
  <div class="anatomy-inner">
    <!-- ================= 1. raw input ================= -->
    <div class="zone" data-reveal>
      <p class="zone-label"><span class="zone-n">1</span>{t.sourcesLabel}</p>
      <div class="sources" id="sources">
        {
          t.sources.map((src) => (
            <article class="src" data-src={src.id}>
              <header class="src-bar">
                <span class="src-dots" aria-hidden="true">
                  <i /><i /><i />
                </span>
                <span class="src-name">{src.name}</span>
              </header>

              {src.kind === 'doc' && (
                <div class="src-doc">
                  <h4>{src.heading}</h4>
                  {(src.paragraphs ?? []).map((p) => (
                    <p set:html={p} />
                  ))}
                </div>
              )}

              {src.kind === 'sheet' && (
                <div class="src-sheet">
                  <table>
                    <tbody>
                      {(src.rows ?? []).map((row, r) => (
                        <tr class={r === 0 ? 'is-head' : ''}>
                          <th scope="row">{r + 1}</th>
                          {row.map((cell) => (
                            <td set:html={cell} />
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {src.kind === 'note' && (
                <div class="src-note">
                  {(src.paragraphs ?? []).map((p) => (
                    <p set:html={p} />
                  ))}
                </div>
              )}

              {src.kind === 'library' && (
                <div class="src-library">
                  <div class="tiles">
                    {TILES.map((g, i) => (
                      <span
                        class={i === 0 ? 'tile is-picked' : 'tile'}
                        style={`background:${g}`}
                        data-span={i === 0 ? 'i1' : undefined}
                      />
                    ))}
                  </div>
                  <p class="tile-meta">
                    <b>{src.assetFile}</b>
                    <span data-span="i2">{src.assetAlt}</span>
                  </p>
                </div>
              )}

              <footer class="src-caption">{src.caption}</footer>
            </article>
          ))
        }
      </div>
      <p class="zone-note">{t.sourcesNote}</p>
    </div>

    <slot name="after-sources" />
    <p class="flow" aria-hidden="true"><span class="flow-arrow"></span></p>

    <!-- ================= 2. structuring ================= -->
    <div class="zone" data-reveal>
      <p class="zone-label"><span class="zone-n">2</span>{t.routesLabel}</p>
      <p class="zone-lead">{t.routesLead}</p>

      <div class="routes" role="tablist" aria-label={t.routesLabel}>
        {
          t.routes.map((r, i) => (
            <button
              type="button"
              role="tab"
              class="route"
              data-route={r.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`route-body-${r.id}`}
              id={`route-tab-${r.id}`}
            >
              <span class="route-label">{r.label}</span>
              <span class="route-blurb">{r.blurb}</span>
            </button>
          ))
        }
      </div>

      {
        t.routes.map((r, i) => (
          <div
            class="surface"
            id={`route-body-${r.id}`}
            role="tabpanel"
            aria-labelledby={`route-tab-${r.id}`}
            data-route-body={r.id}
            hidden={i !== 0}
          >
            <div class="scol">
              <p class="scol-label">{r.leftLabel}</p>

              {r.picker && (
                <div class="mock">
                  <p class="mock-bar">{r.picker.title}</p>
                  <ul class="picks">
                    {r.picker.options.map((opt, oi) => (
                      <li class={oi === (r.picker?.chosen ?? -1) ? 'pick is-picked' : 'pick'}>
                        <svg
                          class="pick-glyph"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                          set:html={GLYPHS[oi] ?? ''}
                        />
                        {opt}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {r.system && (
                <div class="mock">
                  <p class="mock-bar">{r.system.name}</p>
                  <ul class="syslines">
                    {r.system.lines.map((l) => (
                      <li>{l}</li>
                    ))}
                  </ul>
                </div>
              )}

              {r.chat && (
                <div class="chat">
                  {r.chat.map((m) => (
                    <div class={m.self ? 'bub is-self' : 'bub'}>
                      <span class="bub-who">{m.who}</span>
                      <p>{m.text}</p>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <div class="scol">
              <p class="scol-label">{r.rightLabel}</p>

              {r.form && (
                <div class="mock">
                  <p class="mock-bar">{r.form.title}</p>
                  <ul class="formrows">
                    {r.form.fields.map((f) => (
                      <li>
                        <span class="form-key">{f.key}</span>
                        <span class="form-val">{f.value}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="form-more">{r.form.more}</p>
                </div>
              )}

              {r.code && <pre class="wire-code" set:html={r.code} />}

              {r.wire && (
                <ul class="wire">
                  {r.wire.map((w) => (
                    <li class={w.dir === '←' ? 'is-in' : 'is-out'}>
                      <span class="wire-dir" aria-hidden="true">
                        {w.dir}
                      </span>
                      <span set:html={w.text} />
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <p class="surface-note" set:html={r.note} />
          </div>
        ))
      }

      <div class="record">
        <p class="record-cap">{t.recordCaption}</p>
        <pre class="record-code" set:html={RECORD} />
        <p class="record-note">{t.recordNote}</p>
      </div>

      <p class="gate">
        <span class="gate-mark" aria-hidden="true"></span>
        <span set:html={t.gateText} />
      </p>
    </div>

    <slot name="after-routes" />
    <p class="flow" aria-hidden="true"><span class="flow-arrow"></span></p>

    <!-- ================= 3. the slide ================= -->
    <div class="zone" data-reveal>
      <p class="zone-label"><span class="zone-n">3</span>{t.recordLabel}</p>

      <div class="controls">
        <div class="ctl">
          <p class="ctl-label">{t.typeLabel}</p>
          <div class="seg" role="tablist" aria-label={t.typeLabel}>
            {
              t.types.map((type, i) => (
                <button
                  type="button"
                  role="tab"
                  data-type={type.id}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls={`pane-${type.id}`}
                  id={`tab-${type.id}`}
                >
                  {type.label}
                </button>
              ))
            }
          </div>
        </div>
        <div class="ctl">
          <p class="ctl-label">{t.themeLabel}</p>
          <div class="seg seg--theme" role="tablist" aria-label={t.themeLabel}>
            {
              t.themes.map((theme, i) => (
                <button
                  type="button"
                  role="tab"
                  data-theme={theme.id}
                  aria-selected={i === 0 ? 'true' : 'false'}
                >
                  <span class="sw" style={`background:${theme.swatch}`} aria-hidden="true" />
                  {theme.label}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="stage">
        <div class="stage-slide">
          {
            t.types.map((type, i) => (
              <div
                class="pane"
                id={`pane-${type.id}`}
                role="tabpanel"
                aria-labelledby={`tab-${type.id}`}
                data-pane={type.id}
                hidden={i !== 0}
              >
                <div class="slide" data-slide>
                  {type.eyebrow && <p class="slide-eyebrow">{type.eyebrow}</p>}

                  {type.items && (
                    <>
                      <h4 class="slide-title" data-region="title">
                        {type.title}
                      </h4>
                      <ol class="slide-tl" data-region="items">
                        {type.items.map((it) => (
                          <li>
                            <span class="tl-date">{it.date}</span>
                            <span class="tl-title">{it.title}</span>
                          </li>
                        ))}
                      </ol>
                    </>
                  )}

                  {type.bars && (
                    <>
                      <h4 class="slide-title" data-region="title">
                        {type.title}
                      </h4>
                      <div class="slide-chart" data-region="data">
                        {type.bars.map((b) => {
                          const max = Math.max(1, ...type.bars!.map((x) => x.value));
                          return (
                            <div class="bar">
                              <span class="bar-v">{b.value}</span>
                              <span
                                class="bar-fill"
                                style={`height:${Math.round((b.value / max) * 100)}%`}
                              />
                              <span class="bar-l">{b.label}</span>
                            </div>
                          );
                        })}
                      </div>
                    </>
                  )}

                  {type.quote && (
                    <blockquote class="slide-quote">
                      <p data-region="quote">{type.quote.text}</p>
                      <footer>
                        <span class="q-name" data-region="authorName">
                          {type.quote.name}
                        </span>
                        <span class="q-role" data-region="authorTitle">
                          {type.quote.role}
                        </span>
                      </footer>
                    </blockquote>
                  )}

                  {type.image && (
                    <>
                      <h4 class="slide-title slide-title--sm" data-region="title">
                        {type.title}
                      </h4>
                      <figure class="slide-img">
                        <span
                          class="slide-img-frame"
                          data-region="image"
                          style={`background:${TILES[0]}`}
                        />
                        <figcaption data-region="caption">{type.image.caption}</figcaption>
                      </figure>
                    </>
                  )}
                </div>
              </div>
            ))
          }
        </div>

        <div class="stage-side">
          {
            t.types.map((type, i) => (
              <div class="side" data-side={type.id} hidden={i !== 0}>
                <p class="ctl-label ctl-label--fields">
                  {t.fieldsLabel}
                  <span class="typeid">{type.id}</span>
                </p>
                <ul class="fieldlist">
                  {(FIELDS[type.id] ?? []).map((f) => (
                    <li class="field" data-field={f.key} data-spans={f.spans.join(',')} tabindex="0">
                      <span class="field-key">{f.key}</span>
                      <span class="field-type">{f.type}</span>
                      <span class="field-cons">
                        {f.required && <b class="req">required</b>}
                        {f.ordered && <b class="ord">ordered</b>}
                        {f.min != null && <span>min {f.min}</span>}
                        {f.max != null && <span>max {f.max}</span>}
                        {f.maxLen != null && <span>max {f.maxLen}</span>}
                        {f.sub && <span>{f.sub}</span>}
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="claim" set:html={type.claim} />
              </div>
            ))
          }
          <p class="hint">{t.hint}</p>
        </div>
      </div>
    </div>

    <slot name="after-slide" />
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.anatomy');
  if (root) {
    const typeTabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-type]'));
    const themeTabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-theme]'));
    const routeTabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-route]'));
    const panes = Array.from(root.querySelectorAll<HTMLElement>('[data-pane]'));
    const sides = Array.from(root.querySelectorAll<HTMLElement>('[data-side]'));
    const routeBodies = Array.from(root.querySelectorAll<HTMLElement>('[data-route-body]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-src]'));
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));

    // Which raw source each slide type draws on. Mirrors SOURCE_OF above.
    const SOURCE_OF: Record<string, string> = {
      'timeline-slide': 'doc',
      'chart-slide': 'sheet',
      'quote-slide': 'note',
      'image-slide': 'library',
    };

    // Theme tokens. Only the alternates need declaring; the Deckyard theme is
    // the stylesheet default, so switching back just clears the overrides.
    const THEME_KEYS = [
      '--t-bg',
      '--t-ink',
      '--t-accent',
      '--t-head',
      '--t-muted',
      '--t-rule',
      '--t-radius',
      '--t-font-head',
      '--t-font-body',
      '--t-font-eye',
      '--t-eye-ls',
      '--t-node',
      '--t-border',
    ];
    const THEMES: Record<string, Record<string, string>> = {
      deckyard: {},
      council: {
        '--t-bg': '#ffffff',
        '--t-ink': '#12233a',
        '--t-accent': '#1f5fa8',
        '--t-head': '#0d2a4d',
        '--t-muted': '#5a6b7d',
        '--t-rule': '#ccd8e4',
        '--t-radius': '2px',
        '--t-font-head': 'Arial, Helvetica, sans-serif',
        '--t-font-body': 'Arial, Helvetica, sans-serif',
        '--t-font-eye': 'Arial, Helvetica, sans-serif',
        '--t-eye-ls': '0.2em',
        '--t-node': '2px',
        '--t-border': '1px solid #dee6ee',
      },
      editorial: {
        '--t-bg': '#f8f2e7',
        '--t-ink': '#241f18',
        '--t-accent': '#9a3412',
        '--t-head': '#1c1712',
        '--t-muted': '#6b5f4c',
        '--t-rule': '#dbcbad',
        '--t-radius': '2px',
        '--t-font-head': 'Georgia, "Times New Roman", serif',
        '--t-font-body': 'Georgia, "Times New Roman", serif',
        '--t-font-eye': 'var(--mono)',
        '--t-eye-ls': '0.22em',
        '--t-node': '50%',
        '--t-border': '1px solid #e5d8bd',
      },
      studio: {
        '--t-bg': '#111018',
        '--t-ink': '#f3effa',
        '--t-accent': '#57e0c8',
        '--t-head': '#ffffff',
        '--t-muted': '#9a91ad',
        '--t-rule': '#2f2b3d',
        '--t-radius': '12px',
        '--t-font-eye': 'var(--mono)',
        '--t-eye-ls': '0.18em',
        '--t-node': '50%',
        '--t-border': '1px solid #262336',
      },
    };

    function select(list: HTMLButtonElement[], attr: string, value: string) {
      list.forEach((btn) => btn.setAttribute('aria-selected', String(btn.dataset[attr] === value)));
    }

    function showType(typeId: string) {
      select(typeTabs, 'type', typeId);
      panes.forEach((p) => {
        p.hidden = p.dataset.pane !== typeId;
      });
      sides.forEach((s) => {
        s.hidden = s.dataset.side !== typeId;
      });
      // Bring the source this type draws on forward, and mark its passages.
      const srcId = SOURCE_OF[typeId];
      cards.forEach((c) => c.classList.toggle('is-active', c.dataset.src === srcId));
      markUsed(typeId);
    }

    function markUsed(typeId: string) {
      const side = sides.find((s) => s.dataset.side === typeId);
      const used = new Set<string>();
      side?.querySelectorAll<HTMLElement>('.field').forEach((f) => {
        (f.dataset.spans || '')
          .split(',')
          .filter(Boolean)
          .forEach((id) => used.add(id));
      });
      root!.querySelectorAll<HTMLElement>('[data-span]').forEach((s) => {
        s.classList.toggle('is-used', used.has(s.dataset.span || ''));
      });
    }

    function applyTheme(themeId: string) {
      select(themeTabs, 'theme', themeId);
      const vars = THEMES[themeId] || {};
      slides.forEach((slide) => {
        THEME_KEYS.forEach((k) => slide.style.removeProperty(k));
        Object.entries(vars).forEach(([k, v]) => slide.style.setProperty(k, v));
      });
    }

    function showRoute(routeId: string) {
      select(routeTabs, 'route', routeId);
      routeBodies.forEach((b) => {
        b.hidden = b.dataset.routeBody !== routeId;
      });
    }

    function light(field: HTMLElement, on: boolean) {
      const key = field.dataset.field;
      const ids = (field.dataset.spans || '').split(',').filter(Boolean);
      const pane = panes.find((p) => !p.hidden);

      field.classList.toggle('is-lit', on);
      // Some fields (alt, imageRole) drive no visible region: they exist for
      // screen readers or for the renderer. Dimming the slide for those would
      // just look broken, so only probe when there is something to point at.
      const regions = Array.from(pane?.querySelectorAll<HTMLElement>('[data-region]') ?? []);
      const hasRegion = regions.some((r) => r.dataset.region === key);
      pane?.querySelector('.slide')?.classList.toggle('is-probing', on && hasRegion);
      regions.forEach((r) => {
        r.classList.toggle('is-lit', on && r.dataset.region === key);
      });
      root!.querySelectorAll<HTMLElement>('[data-span]').forEach((s) => {
        s.classList.toggle('is-lit', on && ids.includes(s.dataset.span || ''));
      });
    }

    typeTabs.forEach((tab) => tab.addEventListener('click', () => showType(tab.dataset.type || '')));
    themeTabs.forEach((tab) =>
      tab.addEventListener('click', () => applyTheme(tab.dataset.theme || ''))
    );
    routeTabs.forEach((tab) =>
      tab.addEventListener('click', () => showRoute(tab.dataset.route || ''))
    );

    root.querySelectorAll<HTMLElement>('.field').forEach((field) => {
      field.addEventListener('mouseenter', () => light(field, true));
      field.addEventListener('mouseleave', () => light(field, false));
      field.addEventListener('focus', () => light(field, true));
      field.addEventListener('blur', () => light(field, false));
    });

    showType(typeTabs[0]?.dataset.type || '');
  }
</script>

<style>
