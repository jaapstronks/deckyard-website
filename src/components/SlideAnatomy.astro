  /* ---------- 3. the slide ---------- */
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem 2rem;
    margin-bottom: 1.2rem;
  }
  .ctl-label {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 0.45rem;
  }
  .ctl-label--fields {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .typeid {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0;
