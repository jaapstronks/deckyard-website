  }
  .wire li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem;
    padding: 0.5rem 0.65rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.66rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .wire li:last-child {
    border-bottom: 0;
  }
  .wire-dir {
    color: var(--ink-mute);
  }
  .wire .is-in {
    background: var(--green-wash);
  }
  .wire .is-in .wire-dir {
    color: var(--green);
  }
  .wire :global(b) {
    color: var(--green);
