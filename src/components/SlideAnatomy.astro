      box-shadow var(--dur-component) var(--ease-out-quint),
      filter var(--dur-component) var(--ease-out-quint);
  }
  .src:nth-child(1) { rotate: -1.4deg; }
  .src:nth-child(2) { rotate: 0.9deg; }
