  /* Data that moved, not a label about it: mono on a tint, the way a run log
     shows a payload. */
  .step-data {
    margin-top: 0.15rem;
    padding: 0.28rem 0.45rem;
    border-radius: 5px;
    border-left: 2px solid var(--brass);
    background: var(--paper-warm);
    font-family: var(--mono);
    font-size: 0.62rem;
    line-height: 1.55;
    color: var(--ink-soft);
