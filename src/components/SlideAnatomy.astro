    --t-radius: var(--radius-sm);
    --t-font-head: var(--display);
    --t-font-body: var(--body);
    --t-font-eye: var(--mono);
    --t-eye-ls: 0.14em;
    --t-node: 50%;
    --t-border: 1px solid var(--line);

    aspect-ratio: 16 / 9;
    container-type: inline-size;
    background: var(--t-bg);
    color: var(--t-ink);
    font-family: var(--t-font-body);
    border: var(--t-border);
    border-radius: var(--t-radius);
    box-shadow: var(--shadow-md);
    padding: 5cqi;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      background var(--dur-component) ease,
      color var(--dur-component) ease,
      border-radius var(--dur-component) ease;
  }
  .slide [data-region] {
    border-radius: 4px;
    transition:
      opacity var(--dur-micro) ease,
      box-shadow var(--dur-micro) ease;
  }
  .slide.is-probing [data-region] {
    opacity: 0.3;
  }
  .slide.is-probing [data-region].is-lit {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--t-accent);
  }
  .slide-eyebrow {
    font-family: var(--t-font-eye);
    font-size: 1.9cqi;
    letter-spacing: var(--t-eye-ls);
    text-transform: uppercase;
    color: var(--t-accent);
    margin: 0;
  }
  .slide-title {
    font-family: var(--t-font-head);
    font-size: 5.2cqi;
    font-variation-settings: 'wght' 620;
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--t-head);
    margin: 0.3em 0 0;
  }
  .slide-title--sm {
    font-size: 3.6cqi;
  }

  .slide-tl {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    margin: auto 0 0;
    padding: 2cqi 0 0;
    position: relative;
  }
  .slide-tl::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
