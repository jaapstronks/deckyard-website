  .src:nth-child(1) { rotate: -2.4deg; translate: 0 6px; z-index: 4; }
  .src:nth-child(2) { rotate: 1.7deg; translate: 0 -4px; z-index: 3; }
  .src:nth-child(3) { rotate: -1.3deg; translate: 0 10px; z-index: 2; }
