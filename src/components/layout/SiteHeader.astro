---
import DeckyardMark from '@/components/ui/DeckyardMark.astro';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
import { ui, localizePath, sandboxUrl, type Lang } from '@/i18n';

interface Props {
  currentPath: string;
  lang: Lang;
  /** Where this page lives per locale; the switcher routes the rest elsewhere. */
  localeUrls: Partial<Record<Lang, string>>;
  /** Root-form path the switcher falls back to for a missing locale. */
  localeFallback: string;
}
const { currentPath, lang, localeUrls, localeFallback } = Astro.props;
const t = ui[lang];
const isBlog = currentPath.includes('/blog');
const isDocs = currentPath.startsWith('/docs');
const isSpec = currentPath.includes('/spec');
const isStructured = currentPath.includes('/structured-slides');
const isFeatures = currentPath.includes('/features');
const homeHref = localizePath('/', lang);
const blogHref = localizePath('/blog/', lang);
const structuredHref = localizePath('/structured-slides/', lang);
const featuresHref = localizePath('/features/', lang);
const specHref = localizePath('/spec/', lang);
// Docs are English-only; the link stays on the root docs regardless of locale.
const docsHref = '/docs/creating/';
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label={t.nav.homeAria}>
      <DeckyardMark size={30} />
      <span class="brand-name">Deckyard</span>
    </a>

    <div class="header-actions">
      <nav class="site-nav" id="site-nav" aria-label="Primary">
        <!-- The row reads left to right as one question getting narrower: what
             is this / what is in it / is the file mine / how do I run it /
             is it alive. Hosting used to stand where "How it works" now does -
             a commercial door in front of a product the nav did not mention.
             See the note on NavContent for what that rule leaves out. -->
        <a href={structuredHref} aria-current={isStructured ? 'page' : undefined}
          >{t.nav.howItWorks}</a
        >
        <a href={featuresHref} aria-current={isFeatures ? 'page' : undefined}>{t.nav.features}</a>
        <!-- The format spec is in the primary nav, not the footer: a standard
             nobody can find from the front page is not being offered as one. -->
        <a href={specHref} aria-current={isSpec ? 'page' : undefined}>{t.nav.spec}</a>
        <a href={docsHref} aria-current={isDocs ? 'page' : undefined}>{t.nav.docs}</a>
        <a href={blogHref} aria-current={isBlog ? 'page' : undefined}>{t.nav.blog}</a>
        <!-- The mark carries the link on desktop; the label reappears in the
             mobile drawer, where a lone icon in a full-width row reads as a
             mistake. Changelog moved to the footer to keep this row short. -->
        <a
          class="nav-gh"
          href="https://github.com/jaapstronks/deckyard"
          target="_blank"
          rel="noopener"
          title={t.nav.github}
        >
          <svg viewBox="0 0 16 16" width="19" height="19" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
          <span class="nav-gh-label">{t.nav.github}</span>
        </a>
        <LanguageSwitcher
          lang={lang}
          ariaLabel={t.nav.languageAria}
          localeUrls={localeUrls}
          localeFallback={localeFallback}
        />
      </nav>

      <a class="nav-cta" href={sandboxUrl(lang)} target="_blank" rel="noopener">{t.nav.sandbox}</a>

      <button
        type="button"
        class="nav-toggle"
        aria-label={t.nav.menuAria}
        aria-controls="site-nav"
        aria-expanded="false"
        data-nav-toggle
      >
        <span class="nav-toggle-box" aria-hidden="true">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile nav drawer: the hamburger toggles the collapsed .site-nav. On desktop
  // the nav is inline and the toggle is hidden, so this is a no-op there.
  // Re-bind after each view transition so it survives client-side navigation.
  function initNavToggle() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = header?.querySelector<HTMLElement>('#site-nav');
    if (!header || !toggle || !nav || toggle.dataset.bound) return;
    toggle.dataset.bound = 'true';

    const setOpen = (open: boolean) => {
      header.classList.toggle('nav-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => setOpen(!header.classList.contains('nav-open')));

    // Close when a link inside the drawer is followed.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Close on outside-click and Escape.
    document.addEventListener('click', (event) => {
      if (header.classList.contains('nav-open') && !header.contains(event.target as Node)) {
        setOpen(false);
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('nav-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
  initNavToggle();
  document.addEventListener('astro:page-load', initNavToggle);
</script>

<style>
  /* GitHub link: mark only on desktop, mark plus label in the mobile drawer.
     The label is clipped rather than removed so the link keeps an accessible
     name without needing an aria-label to duplicate the same string. */
  .nav-gh {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .nav-gh svg {
    display: block;
  }
  .nav-gh-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Same width as the drawer breakpoint in chrome.css, which is where the bar
     turns into a list of full-width rows. A media query cannot read a token, so
     if one of the two moves the other has to move with it. */
  @media (max-width: 940px) {
    .nav-gh-label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
  }

  /* Sandbox link doubles as a lightweight CTA: a brass pill that reads as an
     action next to the plain nav links, without the weight of a full button.
     It lives outside .site-nav so it stays visible when the nav collapses into
     the mobile drawer. */
  .nav-cta {
    font-family: var(--body);
    font-weight: 550;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    padding: 6px 14px;
    border: 1.5px solid var(--brass-bright);
    border-radius: 999px;
    color: var(--brass-text);
    transition:
      background-color var(--dur-micro) ease,
      color var(--dur-micro) ease;
  }
  .nav-cta:hover {
    background: var(--brass-bright);
    color: var(--green-deep);
  }
</style>
