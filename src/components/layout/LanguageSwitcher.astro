---
import { languages, stripLangFromPath, localizePath, type Lang } from '@/i18n';

interface Props {
  currentPath: string;
  ariaLabel: string;
  /** Locales this page exists in. Anything else routes to the fallback. */
  locales: Lang[];
  /** Root-form path to send a locale that has no version of this page. */
  localeFallback: string;
}
const { currentPath, ariaLabel, locales, localeFallback } = Astro.props;

// Resolve the logical (root-form) path once, then build the URL per locale so
// the switcher lands on the same page in the other language.
//
// Not every page has a counterpart everywhere: a blog post exists in the one
// language it was written in, and its Dutch sibling is a separate post with a
// separate slug. Rather than link to a URL that was never built, those locales
// go to the nearest page that does exist - the blog index, or home. Every
// language stays in the menu, so the switcher does not quietly change shape
// from page to page.
const { path, lang: active } = stripLangFromPath(currentPath);
const here = new Set(locales);

const entries = (Object.keys(languages) as Lang[]).map((lang) => ({
  lang,
  code: lang.toUpperCase(),
  name: languages[lang],
  href: localizePath(here.has(lang) ? path : localeFallback, lang),
  current: lang === active,
}));
---

<details class="lang-switch" data-lang-switch>
  <summary class="lang-switch-trigger" aria-label={ariaLabel}>
    <svg
      class="lang-switch-globe"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path
        d="M3 12h18M12 3c2.4 2.6 3.7 5.7 3.7 9s-1.3 6.4-3.7 9c-2.4-2.6-3.7-5.7-3.7-9S9.6 5.6 12 3Z"
      ></path>
    </svg>
    <span class="lang-switch-code">{active.toUpperCase()}</span>
    <svg
      class="lang-switch-caret"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </summary>

  <ul class="lang-menu" role="list">
    {
      entries.map((entry) => (
        <li>
          <a
            href={entry.href}
            class:list={['lang-menu-item', { 'is-active': entry.current }]}
            aria-current={entry.current ? 'true' : undefined}
            lang={entry.lang}
          >
            <span class="lang-menu-code">{entry.code}</span>
            <span class="lang-menu-name">{entry.name}</span>
            {entry.current && (
              <svg
                class="lang-menu-check"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  // Close the language dropdown on outside-click or Escape.
  //
  // Outside-click has to listen on document, so it is bound once here at module
  // scope and finds the open dropdown at event time. Binding it per element
  // instead would leak a listener on every client-side navigation: ClientRouter
  // swaps in a fresh <details>, the guard below sees an unbound element, and the
  // old closure keeps a detached node alive for the rest of the session.
  // Escape is bound on the element, which is replaced along with it.
  document.addEventListener('click', (event) => {
    document.querySelectorAll<HTMLDetailsElement>('[data-lang-switch][open]').forEach((el) => {
      if (!el.contains(event.target as Node)) el.open = false;
    });
  });

  function initLangSwitch() {
    document.querySelectorAll<HTMLDetailsElement>('[data-lang-switch]').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = 'true';

      el.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          el.open = false;
          el.querySelector<HTMLElement>('summary')?.focus();
        }
      });
    });
  }
  initLangSwitch();
  document.addEventListener('astro:page-load', initLangSwitch);
</script>
