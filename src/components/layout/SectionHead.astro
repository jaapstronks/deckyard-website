---
// The kicker / heading / lead block that opens a section. Every marketing
// section starts with one, so it is a component rather than four hand-written
// elements per section.

interface Props {
  title: string;
  kicker?: string;
  lead?: string;
  center?: boolean;
  /**
   * Heading level. A section head is an h2 under the page's h1, which is right
   * for every page that opens with a hero. A page whose first section head *is*
   * its opening - /embed-demo - passes 1, so the page has an h1 rather than
   * starting its outline at level 2.
   */
  level?: 1 | 2;
  /** Wrap in a scroll-reveal. On by default: every current use reveals. */
  reveal?: boolean;
  revealDelay?: number;
}

const { title, kicker, lead, center = false, level = 2, reveal = true, revealDelay } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';
---

<div
  class:list={['section-head', { 'section-head--center': center }]}
  data-reveal={reveal ? '' : undefined}
  data-reveal-delay={revealDelay}
>
  {kicker && <p class:list={['kicker', { 'kicker--center': center }]}>{kicker}</p>}
  <Heading class="section-head-title">{title}</Heading>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>
