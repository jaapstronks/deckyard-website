---
/**
 * DeckEmbed - embeds a standalone Deckyard HTML export in an iframe.
 *
 * Unlike the SDK embed (src/content/docs/docs/publishing/embedding.md), this
 * needs NO running Deckyard instance, no publishId and no external origin: it
 * points at a self-contained `.html` file exported from Deckyard
 * ("Download -> HTML") and dropped into `public/decks/`. See
 * `public/decks/README.md` for the convention and caveats.
 *
 * Two loading strategies, decided by whether a `poster` is passed:
 *
 * - **Without one**, the iframe is in the HTML and loads lazily. Right for a
 *   deck further down a page.
 * - **With one**, what ships is a link wrapped around a still of the first
 *   slide, costing a few kilobytes against the export's megabyte and a half. On a
 *   screen wide enough to hold a deck the script upgrades that link into an
 *   inline frame - when the browser goes idle, or the moment somebody presses
 *   play - and the poster stays underneath until the frame reports it has
 *   loaded, so nothing flashes. That is what makes a deck affordable above the
 *   fold, and it means the no-JS path is the link that was there all along.
 *
 * Below `inlineFrom` the link is left alone rather than upgraded. The deck is
 * legible at that size since Deckyard 1.6.0, but it is still a megabyte and a
 * half of slides scaled to the width of a hand; a phone is better served by
 * the deck opening in a tab of its own, where it gets the whole screen.
 *
 * The frame is asked for `?ui=min`, which is Deckyard 1.6.0 and later: the
 * export's title bar and control row collapse to zero height, so the frame is
 * the slide and the stage is a plain aspect ratio. The links out keep the
 * unmodified URL - a deck opening in a tab of its own wants its controls.
 *
 * `?ui=min` takes the export's Previous/Next row with it, though, and the play
 * pill it might have replaced lives on the poster, which is removed the moment
 * the frame loads. A deck with no visible control is a deck that reads as a
 * picture of one - which is exactly what the caption underneath it denies. So
 * the embed paints two arrows of its own over the frame and proxies them to the
 * export's own buttons: same navigation, in this page's visual language, with
 * the aspect-ratio contract left alone. See `mountNav` below for what that
 * costs and how it fails safe.
 */
interface Props {
  /** Path to the exported .html deck, e.g. "/decks/my-deck.html". */
  src: string;
  /** Accessible iframe title. */
  title?: string;
  /** Aspect ratio of the slide area, e.g. "16 / 9" or "4 / 3". */
  ratio?: string;
  /** Max width of the embed; anything valid for CSS width. */
  maxWidth?: string;
  /** Still of the first slide. Passing one switches on the deferred load. */
  poster?: string;
  /** Label on the play button. Required whenever `poster` is passed. */
  playLabel?: string;
  /** Media query from which the poster is upgraded to an inline frame. */
  inlineFrom?: string;
  /** Caption link shown when there is no poster. Pass '' to drop it. */
  openLabel?: string;
  /** Accessible name of the back arrow painted over the frame. */
  prevLabel?: string;
  /** Accessible name of the forward arrow painted over the frame. */
  nextLabel?: string;
}

const {
  src,
  title = 'Deckyard presentation',
  ratio = '16 / 9',
  maxWidth = '100%',
  poster,
  playLabel = 'Play the presentation',
  inlineFrom = '(min-width: 700px)',
  openLabel = 'Open the presentation',
  prevLabel = 'Previous slide',
  nextLabel = 'Next slide',
} = Astro.props;

// A ratio that does not parse falls back to 16:9 rather than collapsing the
// box to nothing.
const [ratioW, ratioH] = ratio.split('/').map((part) => Number(part.trim()));
const stageRatio = ratioW > 0 && ratioH > 0 ? `${ratioW} / ${ratioH}` : '16 / 9';

// Only what goes in the frame is asked for the chrome-less interface; every
// link out of here opens the deck on its own, where the controls are the point.
const frameSrc = `${src}${src.includes('?') ? '&' : '?'}ui=min`;
---

<figure
  class="deck-embed"
  style={`--deck-ratio:${stageRatio};--deck-max-width:${maxWidth}`}
  data-deck-src={poster ? frameSrc : undefined}
  data-deck-title={poster ? title : undefined}
  data-deck-inline-from={poster ? inlineFrom : undefined}
>
  <div class="deck-embed__stage">
    {
      poster ? (
        <>
          {/* A link, not a button: it is the whole of the no-JS path and the
              whole of the phone path, and only becomes "play" once the script
              has decided the screen can hold a frame. */}
          <a class="deck-embed__poster" href={src} target="_blank" rel="noopener">
            <img src={poster} alt="" decoding="async" />
            <span class="deck-embed__play">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M8 5.5v13l11-6.5z" />
              </svg>
              {playLabel}
            </span>
          </a>
          {/* Rendered here rather than created in JS, so it carries this
              component's style scope. Without a `src` it is an empty
              about:blank frame costing nothing; the export only starts
              downloading when the script assigns one. */}
          <iframe
            class="deck-embed__frame is-arriving"
            data-deck-frame
            title={title}
            allow="fullscreen"
            referrerpolicy="strict-origin-when-cross-origin"
          />
        </>
      ) : (
        <iframe
          class="deck-embed__frame"
          src={frameSrc}
          title={title}
          loading="lazy"
          allow="fullscreen"
          referrerpolicy="strict-origin-when-cross-origin"
        />
      )
    }
    {
      /* Hidden until the script has found controls in the frame to proxy to, so
        an export too old for `?ui=min` - or one served from another origin,
        where the frame cannot be read - never shows arrows that do nothing. */
    }
    <div class="deck-embed__nav" data-deck-nav hidden>
      <button class="deck-embed__arrow" type="button" data-deck-prev aria-label={prevLabel}>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M15 5 8 12l7 7"></path>
        </svg>
      </button>
      <button class="deck-embed__arrow" type="button" data-deck-next aria-label={nextLabel}>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="m9 5 7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>
  {
    !poster && openLabel && (
      <figcaption class="deck-embed__fallback">
        <a href={src} target="_blank" rel="noopener">
          {openLabel}
        </a>
      </figcaption>
    )
  }
</figure>

<script>
  // The export is a megabyte and a half over the wire, so it is attached after
  // the page is usable rather than as part of it: on idle, or the moment
  // somebody presses play. A reader on a metered connection gets it only when
  // they ask. The poster is removed once the frame reports it has loaded, so
  // the swap has nothing to flash through.
  // The arrows this page paints are a remote control, not a second
  // implementation of "next slide": each one clicks the export's own button
  // inside the frame, so clamping at the ends, the progress fill, the
  // screen-reader announcement and the `#slide=` history entry all stay the
  // export's job. The one coupling is the pair of ids, which is why the whole
  // thing is opt-in on finding them: an export without them (before 1.6.0) or a
  // frame that cannot be read at all (a deck served from another origin) keeps
  // the arrows hidden rather than showing two buttons that do nothing.
  const mountNav = (figure: HTMLElement, frame: HTMLIFrameElement) => {
    const nav = figure.querySelector<HTMLElement>('[data-deck-nav]');
    if (!nav) return;

    let inner: Document | null = null;
    try {
      inner = frame.contentDocument;
    } catch {
      return; // cross-origin: nothing to proxy to.
    }
    if (!inner) return;

    // Duck-typed, not `instanceof`: the frame is a realm of its own, so its
    // buttons are not instances of *this* document's HTMLButtonElement and the
    // check would reject every export there is.
    const isButton = (node: Element | null): node is HTMLButtonElement =>
      !!node && node.tagName === 'BUTTON';

    const pairs: [HTMLButtonElement, HTMLButtonElement][] = [];
    for (const [attr, id] of [
      ['data-deck-prev', 'btnPrev'],
      ['data-deck-next', 'btnNext'],
    ] as const) {
      const ours = figure.querySelector<HTMLButtonElement>(`[${attr}]`);
      const theirs = inner.getElementById(id);
      if (!ours || !isButton(theirs)) return;
      pairs.push([ours, theirs]);
    }

    for (const [ours, theirs] of pairs) {
      // `.click()` runs the listener regardless of the button being laid out;
      // `?ui=min` only hides the row it sits in.
      ours.addEventListener('click', () => theirs.click());
      // Mirrored rather than recomputed, so "is there a slide that way" has one
      // answer and it is the deck's. The export sets it on every slide change.
      const mirror = () => {
        ours.disabled = theirs.disabled;
      };
      mirror();
      new MutationObserver(mirror).observe(theirs, {
        attributes: true,
        attributeFilter: ['disabled'],
      });
    }

    nav.hidden = false;
  };

  const mountDeck = (figure: HTMLElement, takeFocus: boolean) => {
    if (figure.dataset.deckMounted) return;
    figure.dataset.deckMounted = 'true';

    const frame = figure.querySelector<HTMLIFrameElement>('iframe[data-deck-frame]');
    const poster = figure.querySelector<HTMLElement>('.deck-embed__poster');
    if (!frame || !poster) return;

    // Listening only now: the empty frame already fired a load for about:blank
    // when the page parsed, and that one is not the deck.
    frame.addEventListener('load', () => {
      frame.classList.remove('is-arriving');
      poster.remove();
      // The arrows replace the play pill the poster took with it, so they
      // arrive in the same beat rather than after a second hop.
      mountNav(figure, frame);
      // Only after the deck is really there: moving focus into an empty frame
      // would strand the keyboard.
      if (takeFocus) frame.focus();
    });
    frame.src = figure.dataset.deckSrc ?? '';
  };

  // The posterless embed puts its `src` in the HTML and loads it lazily, so
  // there is no mount to hang the arrows off - only the frame's own load. A
  // lazy frame that is already complete by the time this runs (bfcache, a warm
  // reload) would never fire another one, hence the readyState check.
  document.querySelectorAll<HTMLElement>('.deck-embed:not([data-deck-src])').forEach((figure) => {
    const frame = figure.querySelector<HTMLIFrameElement>('iframe');
    if (!frame) return;
    if (frame.contentDocument?.readyState === 'complete') mountNav(figure, frame);
    else frame.addEventListener('load', () => mountNav(figure, frame));
  });

  document.querySelectorAll<HTMLElement>('.deck-embed[data-deck-src]').forEach((figure) => {
    const poster = figure.querySelector('.deck-embed__poster');
    if (!poster) return;

    // Narrow screens keep the link they shipped with. Not a layout problem any
    // more - `?ui=min` scales cleanly all the way down - but a megabyte and a
    // half of deck on a phone is worth an explicit tap, and the deck reads
    // better with the screen to itself. Evaluated once, on load: a phone
    // rotated to landscape is still a phone.
    const inlineFrom = figure.dataset.deckInlineFrom;
    if (inlineFrom && !window.matchMedia(inlineFrom).matches) return;

    poster.addEventListener('click', (event) => {
      event.preventDefault();
      mountDeck(figure, true);
    });

    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } })
      .connection;
    if (connection?.saveData) return;

    // Typed as possibly absent on purpose: Safari only shipped it in 17, and
    // the DOM lib declares it unconditionally, which would make the fallback
    // look unreachable to the type checker.
    const idle: typeof window.requestIdleCallback | undefined = window.requestIdleCallback;
    if (idle) {
      idle(() => mountDeck(figure, false), { timeout: 4000 });
    } else {
      window.setTimeout(() => mountDeck(figure, false), 1500);
    }
  });
</script>

<style>
  .deck-embed {
    margin: 0;
    width: 100%;
    max-width: var(--deck-max-width);
  }

  /* With `?ui=min` the export is the slide and nothing else, so the stage is
     the ratio - no fixed chrome height to add on top of it. */
  .deck-embed__stage {
    position: relative;
    width: 100%;
    aspect-ratio: var(--deck-ratio);
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);

    /* The overlay controls paint their own white plate over the black stage, so
       inside here green is the light-surface green whatever the page is doing.
       Re-pointing the token for the subtree is the same move .section-dark
       makes, in the other direction: the plate decides, not the page. */
    --green: #254d38;
  }
  /* The stage is black and the page is near-black, so the frame ends nowhere.
     A hairline gives it back an edge; the drop shadow has nothing left to
     darken and stops carrying it. */
  :global(:root[data-theme='dark']) .deck-embed__stage {
    box-shadow: 0 0 0 1px var(--line);
  }

  .deck-embed__frame,
  .deck-embed__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* ---------- the poster ---------- */
  .deck-embed__poster {
    background: none;
    text-decoration: none;
    color: inherit;
  }
  /* The still and the stage are both 16:9 now, so `cover` has nothing to crop;
     it stays as the safe answer if a deck is ever embedded at another ratio. */
  .deck-embed__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }
  .deck-embed__poster:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  /* The one thing that says the still is a deck and not a picture of one. */
  .deck-embed__play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.15rem 0.7rem 1rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.94);
    color: var(--green);
    font-family: var(--display);
    font-variation-settings:
      'opsz' 24,
      'wght' 620;
    font-size: var(--step--1);
    white-space: nowrap;
    box-shadow: 0 6px 24px rgba(16, 40, 27, 0.3);
    transition: transform var(--dur-micro) var(--ease-out-quint);
  }
  .deck-embed__poster:hover .deck-embed__play,
  .deck-embed__poster:focus-visible .deck-embed__play {
    transform: translate(-50%, -50%) scale(1.04);
  }

  /* ---------- the arrows ---------- */
  /* Visible at rest, not on hover only: the whole point is that somebody
     glancing at the hero can tell the deck is a deck. Hover and focus just
     brighten what is already there. */
  .deck-embed__arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: var(--green);
    cursor: pointer;
    opacity: 0.78;
    box-shadow: 0 4px 16px rgba(16, 40, 27, 0.28);
    transition:
      opacity var(--dur-micro) var(--ease-out-quint),
      scale var(--dur-micro) var(--ease-out-quint);
  }
  .deck-embed__arrow[data-deck-prev] {
    left: 0.75rem;
  }
  .deck-embed__arrow[data-deck-next] {
    right: 0.75rem;
  }
  .deck-embed__stage:hover .deck-embed__arrow,
  .deck-embed__arrow:focus-visible {
    opacity: 1;
  }
  .deck-embed__arrow:hover:not(:disabled) {
    scale: 1.06;
  }
  .deck-embed__arrow:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }
  /* Left in the tab order on purpose: the export disables its own buttons at
     the ends, and a control that goes quiet says "this is the last slide" more
     clearly than one that vanishes. */
  .deck-embed__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .deck-embed__stage:hover .deck-embed__arrow:disabled {
    opacity: 0.4;
  }

  /* The frame fades in over the poster it replaces, so a deck that arrives on
     idle does not blink into the page while somebody is reading beside it. */
  .deck-embed__frame {
    transition: opacity var(--dur-component) ease;
  }
  /* The empty frame sits above the poster in the stack, so it has to let
     clicks through until it is the thing on screen. */
  .deck-embed__frame.is-arriving {
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .deck-embed__play,
    .deck-embed__frame,
    .deck-embed__arrow {
      transition: none;
    }
    .deck-embed__poster:hover .deck-embed__play,
    .deck-embed__poster:focus-visible .deck-embed__play {
      transform: translate(-50%, -50%);
    }
    .deck-embed__arrow:hover:not(:disabled) {
      scale: 1;
    }
  }

  /* A pill and two arrows told apart from the slide behind them by a background
     colour only; the user's own palette drops that, so give them an edge of
     their own - and an opacity-only disabled state disappears with it, so the
     end of the deck has to be said in a way forced colours keeps. */
  @media (forced-colors: active) {
    .deck-embed__play,
    .deck-embed__arrow {
      border: 2px solid currentColor;
    }
    .deck-embed__arrow:disabled {
      opacity: 1;
      color: GrayText;
      border-color: GrayText;
    }
  }

  /* Fallback link is only useful without the iframe (no-JS / print); the
     iframe itself carries the interactive deck. Keep it discreet. */
  .deck-embed__fallback {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    text-align: center;
  }
  @media print {
    .deck-embed__stage {
      display: none;
    }
  }
</style>
