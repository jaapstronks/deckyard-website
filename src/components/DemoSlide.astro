---
// A small rendered slide, used as the "and this is what comes out" panel under
// each route in the explainer. Deliberately a trimmed copy of the big slide in
// zone 3: same visual language, none of the theme switching or field probing,
// because here the slide is the outcome rather than the subject.
//
// The element the route just produced carries data-fresh, so the page can
// animate it in when you switch route.
interface Bar {
  label: string;
  value: number;
}
interface Moment {
  date: string;
  title: string;
}

interface Props {
  kind: 'timeline' | 'chart';
  eyebrow?: string;
  title?: string;
  items?: Moment[];
  bars?: Bar[];
  /** Index of the element this route just added. */
  fresh?: number;
}
const { kind, eyebrow, title, items = [], bars = [], fresh } = Astro.props;
const max = Math.max(1, ...bars.map((b) => b.value));
---

<div class="ds-shell">
  <div class="ds">
    {eyebrow && <p class="ds-eyebrow">{eyebrow}</p>}
    <h4 class="ds-title">{title}</h4>

    {
      kind === 'timeline' && (
        <ol class="ds-tl">
          {items.map((m, i) => (
            <li data-fresh={i === fresh ? '' : undefined}>
              <span class="ds-date">{m.date}</span>
              <span class="ds-moment">{m.title}</span>
            </li>
          ))}
        </ol>
      )
    }

    {
      kind === 'chart' && (
        <div class="ds-chart">
          {bars.map((b, i) => (
            <div class="ds-bar" data-fresh={i === fresh ? '' : undefined}>
              <span class="ds-bar-v">{b.value}</span>
              <span class="ds-bar-fill" style={`height:${Math.round((b.value / max) * 100)}%`} />
              <span class="ds-bar-l">{b.label}</span>
            </div>
          ))}
        </div>
      )
    }
  </div>
</div>

<style>
  /* The shell is the query container: an element cannot query its own
     container-type, so the slide's own padding needs an outer one. */
  .ds-shell {
    container-type: inline-size;
    min-width: 0;
  }
  .ds {
    aspect-ratio: 16 / 9;
    container-type: inline-size;
    background: var(--card);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    padding: 5cqi;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .ds-eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: 2cqi;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-bright);
  }
  .ds-title {
    margin: 0.35em 0 0;
    font-family: var(--display);
    font-variation-settings: 'wght' 620;
    font-weight: 700;
    font-size: 5cqi;
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .ds-tl {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    margin: auto 0 0;
    padding: 2.2cqi 0 0;
    position: relative;
  }
  .ds-tl::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(2.9cqi - 1px);
    height: 2px;
    background: var(--sage);
  }
  .ds-tl li {
    position: relative;
    padding-right: 2.2cqi;
  }
  .ds-tl li::before {
    content: '';
    position: absolute;
    top: 2.2cqi;
    left: 0;
    width: 1.5cqi;
    height: 1.5cqi;
    border-radius: 50%;
    background: var(--green-bright);
    box-shadow: 0 0 0 0.8cqi var(--card);
  }
  .ds-date {
    display: block;
    margin-top: 4.2cqi;
    font-family: var(--mono);
    font-size: 2.6cqi;
    color: var(--green-bright);
    font-variant-numeric: tabular-nums;
  }
  .ds-moment {
    display: block;
    margin-top: 0.6cqi;
    font-family: var(--display);
    font-variation-settings: 'wght' 600;
    font-weight: 700;
    font-size: 2.4cqi;
    line-height: 1.15;
    color: var(--ink);
  }

  .ds-chart {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 4cqi;
    margin-top: auto;
    height: 54%;
  }
  /* Grid rather than flex: the bar percentage has to resolve against a track
     that excludes the value and the label. */
  .ds-bar {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
  }
  .ds-bar-v {
    text-align: center;
    padding-bottom: 0.8cqi;
    font-family: var(--display);
    font-variation-settings: 'wght' 620;
    font-weight: 700;
    font-size: 2.4cqi;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .ds-bar-fill {
    align-self: end;
    width: 100%;
    background: var(--green-bright);
    border-radius: 3px 3px 0 0;
  }
  .ds-bar-l {
    text-align: center;
    padding-top: 1cqi;
    font-family: var(--mono);
    font-size: 1.9cqi;
    color: var(--ink-mute);
    border-top: 1px solid var(--sage);
  }

  /* What this route just added. The brass tint stays after the animation, so
     it still reads as "this is the new one" on a still page. */
  [data-fresh] .ds-date,
  [data-fresh] .ds-bar-v {
    color: var(--brass);
  }
  [data-fresh] .ds-bar-fill {
    background: var(--brass);
  }
  .ds-tl li[data-fresh]::before {
    background: var(--brass);
  }
  :global(.surface.is-switching) [data-fresh] {
    animation: ds-arrive var(--dur-component, 420ms) var(--ease-out-quint, ease-out) both;
  }
  @keyframes ds-arrive {
    from {
      opacity: 0;
      translate: 0 8px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.surface.is-switching) [data-fresh] {
      animation: none;
    }
  }
</style>
