---
// Homepage teaser for the "how it works" explainer. One picture, one claim:
// the slide you are looking at is made of named fields, so it knows what it is.
//
// Deliberately not a before/after. The document-becomes-a-slide story needs the
// full width of /structured-slides to be legible; squeezed into half a homepage
// section it reads as two grey rectangles with an arrow between them. Here the
// slide carries real content and the field names point at the regions they own.
//
// The content is borrowed from the anatomy dictionary and rendered by the same
// Slide component, so this is literally the slide you meet again on the
// explainer page - not a lookalike that can drift away from it.
import { ui, localizePath, type Lang } from '@/i18n';
import Slide from '@/components/ui/Slide.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].structured;
const href = localizePath('/structured-slides', lang);

const timeline = ui[lang].anatomy.types.find((x) => x.id === 'timeline-slide');
// Three moments rather than four: at this size the columns need the room, and
// ending on "resumed" beats ending on "suspended".
const MOMENTS = [0, 1, 3].map((i) => timeline?.items?.[i]).filter(Boolean) as {
  date: string;
  title: string;
}[];

// Where each callout attaches, as a share of the slide's height. The slide has
// a fixed aspect ratio, so these stay put at every width.
const NOTES = [
  { key: 'title', at: '27%', cons: ['string · max 120'] },
  { key: 'items', at: '76%', cons: ['required · ordered', 'date · title · text'] },
];
---

<section class="section teaser">
  <div class="container teaser-grid">
    <div class="teaser-copy" data-reveal>
      <p class="kicker">{t.teaserKicker}</p>
      <h2>{t.teaserTitle}</h2>
      <p class="lead">{t.teaserBody}</p>
      <a class="btn btn-primary" href={href}>{t.teaserCta}</a>
    </div>

    <figure class="teaser-art" data-reveal data-reveal-delay="120">
      <div class="ta-frame">
        <Slide
          variant="figure"
          eyebrow={timeline?.eyebrow}
          title={timeline?.title}
          items={MOMENTS}
        />

        <ul class="ta-notes">
          {
            NOTES.map((n) => (
              <li class="ta-note" style={`--at:${n.at}`}>
                <span class="ta-key">{n.key}</span>
                {n.cons.map((c) => (
                  <span class="ta-cons">{c}</span>
                ))}
              </li>
            ))
          }
        </ul>
      </div>

      <figcaption class="ta-foot">
        <b>timeline-slide</b>
        <span>{t.teaserFoot}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  /* The hero above already ends on a generous 130px, and both sections sit on
     the same paper, so a full section padding on top of that reads as a hole
     rather than as a break. Trim the top, keep the bottom. */
  .teaser {
    padding-block-start: 0;
  }
  .teaser-grid {
    display: grid;
    gap: 2.2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .teaser-grid {
      grid-template-columns: 1fr 1.05fr;
      gap: 3.5rem;
    }
  }
  .teaser-copy h2 {
    margin-bottom: 0.6rem;
  }
  .teaser-copy .lead {
    margin-bottom: 1.6rem;
  }

  /* ---------- the illustration ---------- */
  /* Queried on its own width, not the viewport: the callouts may only sit
     beside the slide when the column is wide enough that the slide keeps a
     readable size. On a 900px screen this block is half the page. */
  .teaser-art {
    margin: 0;
    container-type: inline-size;
  }
  .ta-frame {
    display: grid;
    gap: 1.5rem;
  }
  @container (min-width: 460px) {
    .ta-frame {
      grid-template-columns: 1fr 7.5rem;
      align-items: stretch;
    }
  }

  /* the field names, pointing back at the regions they own */
  .ta-notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
  }
  @container (min-width: 460px) {
    .ta-notes {
      position: relative;
      display: block;
    }
    .ta-note {
      position: absolute;
      top: var(--at);
      translate: 0 -50%;
      width: 100%;
    }
    /* the hairline back to the slide edge, with the arrowhead at that end */
    .ta-note::before {
      content: '';
      position: absolute;
      right: calc(100% + 0.5rem);
      top: 0.42rem;
      width: 0.7rem;
      border-top: 1px solid var(--line);
    }
    .ta-note::after {
      content: '';
      position: absolute;
      right: calc(100% + 1.2rem);
      top: 0.42rem;
      translate: 0 -50%;
      border-top: 3.5px solid transparent;
      border-bottom: 3.5px solid transparent;
      border-right: 5px solid var(--brass);
    }
  }
  .ta-key {
    display: block;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink);
  }
  .ta-cons {
    display: block;
    font-family: var(--mono);
    font-size: 0.58rem;
    line-height: 1.5;
    color: var(--ink-mute);
  }

  .ta-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.85rem;
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
    color: var(--ink-mute);
  }
  .ta-foot b {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--green-bright);
  }
</style>
