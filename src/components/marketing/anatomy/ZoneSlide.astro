---
// Zone 3: one slide under two independent controls - the type (what it means)
// and the house style (how it looks). Changing one never touches the other,
// which is the whole thesis of the page. The field list beside it is the
// record the slide actually is; hovering a field lights the region it drives.
import { ui, type Lang } from '@/i18n';
import { FIELDS, TILES } from './data';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].anatomy;

const libraryAlt = t.sources.find((s) => s.kind === 'library')?.assetAlt ?? '';
---

<div class="zone" data-reveal>
  <p class="zone-label"><span class="zone-n">3</span>{t.recordLabel}</p>

  <div class="controls">
    <div class="ctl">
      <p class="ctl-label">{t.typeLabel}</p>
      <div class="seg" role="tablist" aria-label={t.typeLabel}>
        {
          t.types.map((type, i) => (
            <button
              type="button"
              role="tab"
              data-type={type.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`pane-${type.id}`}
              id={`tab-${type.id}`}
            >
              {type.label}
            </button>
          ))
        }
      </div>
    </div>
    <div class="ctl">
      <p class="ctl-label">{t.themeLabel}</p>
      <div class="seg seg--theme" role="tablist" aria-label={t.themeLabel}>
        {
          t.themes.map((theme, i) => (
            <button
              type="button"
              role="tab"
              data-theme={theme.id}
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              <span class="sw" style={`background:${theme.swatch}`} aria-hidden="true" />
              {theme.label}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="stage">
    <div class="stage-slide">
      {
        t.types.map((type, i) => (
          <div
            class="pane"
            id={`pane-${type.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${type.id}`}
            data-pane={type.id}
            hidden={i !== 0}
          >
            <div class="slide" data-slide>
              {type.eyebrow && <p class="slide-eyebrow">{type.eyebrow}</p>}

              {type.items && (
                <>
                  <h4 class="slide-title" data-region="title">
                    {type.title}
                  </h4>
                  <ol class="slide-tl" data-region="items">
                    {type.items.map((it) => (
                      <li>
                        <span class="tl-date">{it.date}</span>
                        <span class="tl-title">{it.title}</span>
                      </li>
                    ))}
                  </ol>
                </>
              )}

              {type.bars && (
                <>
                  <h4 class="slide-title" data-region="title">
                    {type.title}
                  </h4>
                  <div class="slide-chart" data-region="data">
                    {type.bars.map((b) => {
                      const max = Math.max(1, ...type.bars!.map((x) => x.value));
                      return (
                        <div class="bar">
                          <span class="bar-v">{b.value}</span>
                          <span
                            class="bar-fill"
                            style={`height:${Math.round((b.value / max) * 100)}%`}
                          />
                          <span class="bar-l">{b.label}</span>
                        </div>
                      );
                    })}
                  </div>
                </>
              )}

              {type.quote && (
                <blockquote class="slide-quote">
                  <p data-region="quote">{type.quote.text}</p>
                  <footer>
                    <span class="q-name" data-region="authorName">
                      {type.quote.name}
                    </span>
                    <span class="q-role" data-region="authorTitle">
                      {type.quote.role}
                    </span>
                  </footer>
                </blockquote>
              )}

              {type.image && (
                <>
                  <h4 class="slide-title slide-title--sm" data-region="title">
                    {type.title}
                  </h4>
                  <figure class="slide-img">
                    <img
                      class="slide-img-frame"
                      data-region="image"
                      src={TILES[0]}
                      alt={libraryAlt}
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption data-region="caption">{type.image.caption}</figcaption>
                  </figure>
                </>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div class="stage-side">
      {
        t.types.map((type, i) => (
          <div class="side" data-side={type.id} hidden={i !== 0}>
            <p class="ctl-label ctl-label--fields">
              {t.fieldsLabel}
              <span class="typeid">{type.id}</span>
            </p>
            <ul class="fieldlist">
              {(FIELDS[type.id] ?? []).map((f) => (
                <li class="field" data-field={f.key} data-spans={f.spans.join(',')} tabindex="0">
                  <span class="field-key">{f.key}</span>
                  <span class="field-type">{f.type}</span>
                  <span class="field-cons">
                    {f.required && <b class="req">required</b>}
                    {f.ordered && <b class="ord">ordered</b>}
                    {f.min != null && <span>min {f.min}</span>}
                    {f.max != null && <span>max {f.max}</span>}
                    {f.maxLen != null && <span>max {f.maxLen}</span>}
                    {f.sub && <span>{f.sub}</span>}
                  </span>
                </li>
              ))}
            </ul>
            <p class="claim" set:html={type.claim} />
          </div>
        ))
      }
      <p class="hint">{t.hint}</p>
    </div>
  </div>
</div>

<slot name="after-slide" />

<style>
  /* ---------- 3. the slide ---------- */
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem 2rem;
    margin-bottom: 1.2rem;
  }
  .ctl-label {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 0.45rem;
  }
  .ctl-label--fields {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .typeid {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--green-bright);
  }
  .seg {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
    padding: 0.24rem;
    background: var(--paper-warm);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    width: fit-content;
    max-width: 100%;
  }
  .seg button {
    font-family: var(--body);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.4rem 0.78rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    transition:
      background var(--dur-micro) ease,
      color var(--dur-micro) ease;
  }
  .seg button:hover {
    background: var(--sage);
    color: var(--ink);
  }
  .seg button[aria-selected='true'] {
    background: var(--green);
    color: var(--paper);
  }
  .seg--theme button[aria-selected='true'] {
    background: var(--ink);
  }
  .sw {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    flex: none;
  }

  .stage {
    display: grid;
    gap: 1.4rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .stage {
      grid-template-columns: 1.55fr 1fr;
      gap: 1.8rem;
    }
  }

  /* The pane is the query container, not the slide. An element cannot query its
   own container-type, so `cqi` in the slide's own declarations (its padding)
   would otherwise resolve against the viewport instead of the slide width. */
  .pane {
    container-type: inline-size;
  }

  /* The slide carries its own palette, independent of the page: that is the
   point of the house-style control. Tokens default to Deckyard's own. */
  .slide {
    --t-bg: var(--card);
    --t-ink: var(--ink);
    --t-accent: var(--green-bright);
    --t-head: var(--ink);
    --t-muted: var(--ink-mute);
    --t-rule: var(--sage);
    --t-radius: var(--radius-sm);
    --t-font-head: var(--display);
    --t-font-body: var(--body);
    --t-font-eye: var(--mono);
    --t-eye-ls: 0.14em;
    --t-node: 50%;
    --t-border: 1px solid var(--line);

    aspect-ratio: 16 / 9;
    container-type: inline-size;
    background: var(--t-bg);
    color: var(--t-ink);
    font-family: var(--t-font-body);
    border: var(--t-border);
    border-radius: var(--t-radius);
    box-shadow: var(--shadow-md);
    padding: 5cqi;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      background var(--dur-component) ease,
      color var(--dur-component) ease,
      border-radius var(--dur-component) ease;
  }
  .slide [data-region] {
    border-radius: 4px;
    transition:
      opacity var(--dur-micro) ease,
      box-shadow var(--dur-micro) ease;
  }
  .slide.is-probing [data-region] {
    opacity: 0.3;
  }
  .slide.is-probing [data-region].is-lit {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--t-accent);
  }
  .slide-eyebrow {
    font-family: var(--t-font-eye);
    font-size: 1.9cqi;
    letter-spacing: var(--t-eye-ls);
    text-transform: uppercase;
    color: var(--t-accent);
    margin: 0;
  }
  .slide-title {
    font-family: var(--t-font-head);
    font-size: 5.2cqi;
    font-variation-settings: 'wght' 620;
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--t-head);
    margin: 0.3em 0 0;
  }
  .slide-title--sm {
    font-size: 3.6cqi;
  }

  .slide-tl {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    margin: auto 0 0;
    padding: 2cqi 0 0;
    position: relative;
  }
  .slide-tl::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(2.7cqi - 1px);
    height: 2px;
    background: var(--t-rule);
  }
  .slide-tl li {
    position: relative;
    padding-right: 2cqi;
  }
  .slide-tl li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1.4cqi;
    height: 1.4cqi;
    border-radius: var(--t-node);
    background: var(--t-accent);
    box-shadow: 0 0 0 0.7cqi var(--t-bg);
  }
  .tl-date {
    display: block;
    margin-top: 3.4cqi;
    font-family: var(--t-font-eye);
    font-size: 2.2cqi;
    color: var(--t-accent);
    font-variant-numeric: tabular-nums;
  }
  .tl-title {
    display: block;
    margin-top: 0.5cqi;
    font-family: var(--t-font-head);
    font-variation-settings: 'wght' 600;
    font-weight: 700;
    font-size: 2.1cqi;
    line-height: 1.15;
    color: var(--t-head);
  }

  .slide-chart {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 4.5cqi;
    margin-top: auto;
    height: 58%;
  }
  /* Grid, not flex: the bar height percentage must resolve against a track that
   excludes the value and the label, or the proportions get distorted. */
  .bar {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
  }
  .bar-v {
    text-align: center;
    padding-bottom: 0.8cqi;
    font-family: var(--t-font-head);
    font-variation-settings: 'wght' 620;
    font-weight: 700;
    font-size: 2.1cqi;
    color: var(--t-head);
    font-variant-numeric: tabular-nums;
  }
  .bar-fill {
    align-self: end;
    width: 100%;
    background: var(--t-accent);
    border-radius: 3px 3px 0 0;
  }
  .bar-l {
    text-align: center;
    padding-top: 1cqi;
    font-family: var(--t-font-eye);
    font-size: 1.7cqi;
    color: var(--t-muted);
    border-top: 1px solid var(--t-rule);
  }

  .slide-quote {
    margin: auto 0;
    padding: 0;
  }
  .slide-quote p {
    font-family: var(--t-font-head);
    font-variation-settings: 'wght' 600;
    font-weight: 700;
    font-size: 5.4cqi;
    line-height: 1.18;
    letter-spacing: -0.022em;
    color: var(--t-head);
    margin: 0;
    max-width: 88%;
  }
  .slide-quote p::before {
    content: '\201C';
  }
  .slide-quote p::after {
    content: '\201D';
  }
  .slide-quote footer {
    margin-top: 3cqi;
    font-size: 1.9cqi;
  }
  .q-name {
    display: block;
    font-weight: 600;
    color: var(--t-ink);
  }
  .q-role {
    display: block;
    color: var(--t-muted);
  }

  .slide-img {
    margin: 2cqi 0 0;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }
  .slide-img-frame {
    flex: 1;
    width: 100%;
    object-fit: cover;
    border-radius: calc(var(--t-radius) / 2);
    min-height: 0;
  }
  .slide-img figcaption {
    margin-top: 1.4cqi;
    font-size: 1.7cqi;
    color: var(--t-muted);
    font-family: var(--t-font-eye);
  }

  /* ---------- field list ---------- */
  .fieldlist {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--card);
    overflow: hidden;
  }
  .field {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 0.7rem;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.72rem;
    transition: background var(--dur-micro) ease;
  }
  .field:last-child {
    border-bottom: 0;
  }
  .field:hover,
  .field.is-lit {
    background: var(--green-wash);
  }
  .field-key {
    grid-column: 1;
    grid-row: 1;
    color: var(--ink);
    font-weight: 700;
  }
  .field-type {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    font-size: 0.62rem;
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--line);
    background: var(--paper-warm);
    color: var(--ink-mute);
  }
  .field-cons {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.6rem;
    font-size: 0.64rem;
    color: var(--ink-mute);
  }
  .field-cons .req {
    color: #9a3412;
    font-weight: 700;
  }
  .field-cons .ord {
    color: var(--green-bright);
    font-weight: 700;
  }

  .claim {
    margin: 0.9rem 0 0;
    padding: 0.8rem 0.95rem;
    background: var(--green-wash);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .claim :global(b) {
    font-family: var(--mono);
    font-size: 0.85em;
    color: var(--green);
  }
  .hint {
    margin: 0.9rem 0 0;
    font-family: var(--mono);
    font-size: 0.64rem;
    color: var(--ink-mute);
  }

  /* Type/theme switching and the field probe are this zone's motion. */
  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide [data-region],
    .seg button,
    .field {
      transition: none;
    }
  }
</style>
