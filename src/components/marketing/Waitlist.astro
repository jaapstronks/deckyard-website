---
// Email capture via self-hosted Listmonk (same instance as Dreamkit).
// List: "Deckyard launch updates" (id 13, double opt-in) on listmonk.dreamkit.eu.
import { ui, defaultLang, type Lang } from '@/i18n';

const LISTMONK_URL = 'https://listmonk.dreamkit.eu/subscription/form';
const LIST_UUID = '7c6489d5-d6a8-40c0-be60-bd0918cbdc06';

interface Props {
  id: string;
  lang?: Lang;
  buttonLabel?: string;
}
const { id, lang = defaultLang, buttonLabel } = Astro.props;
const t = ui[lang].waitlist;
const label = buttonLabel ?? t.button;
---

<div class="waitlist" data-waitlist>
  <form
    class="waitlist-form"
    method="post"
    action={LISTMONK_URL}
    data-waitlist-form
    data-status-ok={t.statusOk}
    data-status-error={t.statusError}
  >
    <input type="hidden" name="l" value={LIST_UUID} />
    <label class="wl-nonce" aria-hidden="true">
      {t.honeypot}
      <input type="text" name="nonce" tabindex="-1" autocomplete="off" />
    </label>
    <label class="wl-nonce" for={`${id}-email`}>{t.emailLabel}</label>
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      required
      placeholder={t.placeholder}
      autocomplete="email"
      aria-describedby={`${id}-note`}
    />
    <button class="btn btn-primary" type="submit">{label}</button>
  </form>
  <!-- role="status" as well as aria-live: the two are equivalent on paper, but
       a region that carries the role is announced far more reliably by older
       screen readers than a bare aria-live attribute. -->
  <p class="waitlist-status" data-waitlist-status hidden role="status" aria-live="polite"></p>
  <p class="waitlist-note" id={`${id}-note`}>{t.note}</p>
</div>

<script>
  function initWaitlist() {
    document.querySelectorAll<HTMLFormElement>('[data-waitlist-form]').forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = 'true';
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const status = form.parentElement?.querySelector<HTMLElement>('[data-waitlist-status]');
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
        if (button) button.disabled = true;
        try {
          // Listmonk sends no CORS headers; no-cors means an opaque response,
          // so success is optimistic — the double-opt-in email is the real confirmation.
          await fetch(form.action, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
          });
          if (status) {
            status.hidden = false;
            status.dataset.state = 'ok';
            status.textContent =
              form.dataset.statusOk ?? 'Almost there: check your inbox to confirm your address.';
          }
          form.reset();
        } catch {
          if (status) {
            status.hidden = false;
            status.dataset.state = 'error';
            status.textContent =
              form.dataset.statusError ?? 'That did not work. Please try again in a moment.';
          }
        } finally {
          if (button) button.disabled = false;
        }
      });
    });
  }
  initWaitlist();
  document.addEventListener('astro:page-load', initWaitlist);
</script>

<style>
  .waitlist-form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 520px;
  }
  /* Colours come from the --field-* / --note-fg / --status-fg tokens so the
     form works on a light or dark section without knowing which it is on.
     See .section-dark in styles/primitives.css. */
  .waitlist-form input[type='email'] {
    flex: 1 1 240px;
    font: inherit;
    padding: 13px 18px;
    border: 1.5px solid var(--field-border);
    border-radius: var(--radius-sm);
    background: var(--field-bg);
    color: var(--field-fg);
    transition:
      border-color var(--dur-micro) ease,
      box-shadow var(--dur-micro) ease;
  }
  /* The border swap and the soft ring are the house treatment; the outline is
     the accessible one and is deliberately not suppressed here. This block
     used to open with `outline: none`, and because component styles outrank
     every layer that also cancelled the global :focus-visible ring - on a dark
     section the remaining tint is 0.18 alpha, which is not an indicator. */
  .waitlist-form input[type='email']:focus {
    border-color: var(--field-focus-border);
    box-shadow: 0 0 0 4px var(--field-focus-ring);
  }
  .waitlist-form input[type='email']::placeholder {
    color: var(--field-placeholder);
  }

  .waitlist-note {
    font-size: 0.82rem;
    color: var(--note-fg);
    margin-top: 10px;
    max-width: 46em;
  }
  .waitlist-status {
    font-weight: 600;
    margin-top: 12px;
    color: var(--status-fg);
  }
  /* Hard-coded, this was 2.2:1 on the dark section the form usually sits on.
     --error-fg is the token that flips with the surface (see primitives.css). */
  .waitlist-status[data-state='error'] {
    color: var(--error-fg);
  }

  /* Honeypot + visually-hidden label. */
  .wl-nonce {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
