---
import SiteLayout from '@/layouts/SiteLayout.astro';
import DeckEmbed from '@/components/ui/DeckEmbed.astro';
import Section from '@/components/layout/Section.astro';
import SectionHead from '@/components/layout/SectionHead.astro';
---

<SiteLayout
  title="Static deck embed - Deckyard"
  description="Embed a self-contained Deckyard HTML export with no running instance."
  localeUrls={{ en: '/embed-demo/' }}
>
  <Section>
    <SectionHead center level={1} kicker="Static embed" title="A deck, embedded without a server">
      <p class="lead">
        The presentation below is a single self-contained HTML file dropped in
        <code>public/decks/</code> and embedded with <code>&lt;DeckEmbed&gt;</code>. No running
        Deckyard instance, no external origin.
      </p>
    </SectionHead>
    <div data-reveal data-reveal-delay="80">
      <DeckEmbed src="/decks/example.html" title="Example deck" />
    </div>
  </Section>
</SiteLayout>
