---
// One route for every locale's blog posts. A post's language is the folder it
// sits in, so there is no cross product to filter: each file produces exactly
// one page, in exactly one language.
import { getCollection } from 'astro:content';
import BlogPostPage from '@/components/pages/BlogPostPage.astro';
import { postLang, postSlug, postLocaleUrls } from '@/lib/blog';
import { defaultLang } from '@/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );

  return posts.map((post) => {
    const lang = postLang(post);
    return {
      params: { locale: lang === defaultLang ? undefined : lang, slug: postSlug(post) },
      // Resolved against the same filtered list the routes are built from, so a
      // translation that is still a draft is not advertised as one.
      props: { post, lang, localeUrls: postLocaleUrls(post, posts) },
    };
  });
}

const { post, lang, localeUrls } = Astro.props;
---

<BlogPostPage post={post} lang={lang} localeUrls={localeUrls} />
